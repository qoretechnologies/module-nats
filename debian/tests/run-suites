set -eu
# Debian installs the broker in /usr/sbin, outside an unprivileged user's PATH.
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
command -v nats-server >/dev/null
for suite in test/*.qtest; do
    timeout 600 /usr/bin/qore --enable-debug \
        -l "$QORE_NATS_TEST_MODULE_DIR/nats-api-$(/usr/bin/qore --latest-module-api).qmod" \
        -l "$QORE_NATS_TEST_QMOD_DIR/NatsUtil/NatsUtil.qmod" \
        -l "$QORE_NATS_TEST_QMOD_DIR/NatsDataProvider/NatsDataProvider.qmod" \
        -l "$QORE_NATS_TEST_QMOD_DIR/NatsJetStreamDataProvider/NatsJetStreamDataProvider.qmod" \
        "$suite" -v
done
