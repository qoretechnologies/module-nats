#include "nats-module.h"
#include "QC_NatsMicroGroup.h"

//! The NatsMicroGroup class provides endpoint group management for NATS microservices
/**
    Groups organize endpoints under a common subject prefix. For example, endpoints
    added to a group with prefix \c "api" will have their subjects prefixed with
    \c "api.".

    @par Example:
    @code{.py}
NatsMicroGroup grp = svc.addGroup("api");
NatsMicroGroup sub_grp = grp.addGroup("v2");
sub_grp.addEndpoint(<NatsMicroEndpointConfig>{
    "name": "users",
    "handler": *data sub (hash<auto> req) { return "user list"; },
});
# endpoint listens on "api.v2.users"
    @endcode

    @note NatsMicroGroup objects are created by @ref NatsMicroService::addGroup()
    or @ref NatsMicroGroup::addGroup() -- not directly instantiated.

    @since %nats 1.0
*/
qclass NatsMicroGroup [arg=QoreNatsMicroGroup* mgrp; ns=Qore::Nats; dom=NETWORK];

//! Adds a sub-group with a subject prefix
/** @param prefix the subject prefix for the sub-group

    @return a new @ref NatsMicroGroup object

    @throw NATS-MICRO-ERROR if the group creation fails

    @since %nats 1.0
*/
NatsMicroGroup NatsMicroGroup::addGroup(string prefix) [flags=NAMED_ARGS] {
    QoreNatsMicroGroup* g = mgrp->addGroup(prefix->c_str(), xsink);
    if (!g) {
        return QoreValue();
    }
    return new QoreObject(QC_NATSMICROGROUP, getProgram(), g);
}

//! Adds an endpoint to the group
/** The endpoint's subject will be prefixed with the group's prefix.

    @param config the endpoint configuration (see @ref NatsMicroEndpointConfig)

    @throw NATS-MICRO-ERROR if the endpoint creation fails

    @par Example:
    @code{.py}
grp.addEndpoint(<NatsMicroEndpointConfig>{
    "name": "hello",
    "handler": *data sub (hash<auto> req) { return "world"; },
});
    @endcode

    @since %nats 1.0
*/
nothing NatsMicroGroup::addEndpoint(hash<NatsMicroEndpointConfig> config) [flags=NAMED_ARGS] {
    mgrp->addEndpoint(config, getProgram(), xsink);
}
