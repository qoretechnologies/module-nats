#include "nats-module.h"
#include "QC_NatsKeyValueWatcher.h"

//! Watches a NATS KV store for changes
/** This class provides a polling interface to watch for key-value changes.

    @par Example: Watch for all key changes
    @code{.py}
NatsConnection conn("nats://localhost:4222");
JetStreamContext js = conn.jetStream();
NatsKeyValueStore kv = js.keyValue("config");

NatsKeyValueWatcher watcher = kv.watchAll(<NatsKVWatchOptions>{"updates_only": True});
while (True) {
    *hash<NatsKVEntry> entry = watcher.next(5s);
    if (entry) {
        printf("Key %s changed: %s\n", entry.key, entry.value.toString());
    }
}
watcher.stop();
    @endcode

    @note NatsKeyValueWatcher objects are created by @ref NatsKeyValueStore::watch(),
    @ref NatsKeyValueStore::watchMulti(), or @ref NatsKeyValueStore::watchAll() --
    not directly instantiated.

    @since %nats 1.0
*/
qclass NatsKeyValueWatcher [arg=QoreNatsKVWatcher* w; ns=Qore::Nats; dom=NETWORK];

//! Gets the next KV entry update
/** @param timeout_ms timeout in milliseconds (default: 5 seconds)

    @return a @ref NatsKVEntry hash, or @ref nothing on timeout

    @throw NATS-KV-WATCH-ERROR if the watcher is not valid or an error occurs

    @since %nats 1.0
*/
*hash<NatsKVEntry> NatsKeyValueWatcher::next(timeout timeout_ms = 5s) [flags=NAMED_ARGS] {
    return w->next(timeout_ms, xsink);
}

//! Stops the watcher
/** After calling stop, any pending or future calls to @ref next() will return
    immediately.

    @throw NATS-KV-WATCH-ERROR if the watcher is not valid or stop fails

    @since %nats 1.0
*/
nothing NatsKeyValueWatcher::stop() {
    w->stop(xsink);
}
