#include "nats-module.h"

/** @defgroup nats_retention_policies NATS JetStream Retention Policies
    These constants define JetStream stream retention policies.
*/
///@{
//! Messages are retained based on limits (max messages, bytes, age)
const NATS_RETENTION_LIMITS = 0;

//! Messages are retained until acknowledged by all consumers
const NATS_RETENTION_INTEREST = 1;

//! Messages are retained until acknowledged (work queue pattern)
const NATS_RETENTION_WORKQUEUE = 2;
///@}

/** @defgroup nats_storage_types NATS JetStream Storage Types
    These constants define JetStream stream storage types.
*/
///@{
//! Store messages on disk
const NATS_STORAGE_FILE = 0;

//! Store messages in memory
const NATS_STORAGE_MEMORY = 1;
///@}

/** @defgroup nats_discard_policies NATS JetStream Discard Policies
    These constants define what happens when a stream reaches its limits.
*/
///@{
//! Discard old messages when the stream is full
const NATS_DISCARD_OLD = 0;

//! Reject new messages when the stream is full
const NATS_DISCARD_NEW = 1;
///@}

/** @defgroup nats_ack_policies NATS JetStream Ack Policies
    These constants define consumer acknowledgment policies.
*/
///@{
//! No acknowledgment required
const NATS_ACK_NONE = 0;

//! All messages must be acknowledged
const NATS_ACK_ALL = 1;

//! Each message must be individually acknowledged
const NATS_ACK_EXPLICIT = 2;
///@}

/** @defgroup nats_deliver_policies NATS JetStream Deliver Policies
    These constants define consumer delivery policies.
*/
///@{
//! Deliver all available messages
const NATS_DELIVER_ALL = 0;

//! Deliver starting with the last message
const NATS_DELIVER_LAST = 1;

//! Deliver only new messages (received after consumer creation)
const NATS_DELIVER_NEW = 2;

//! Deliver starting from a specific sequence number
const NATS_DELIVER_BY_START_SEQUENCE = 3;

//! Deliver starting from a specific time
const NATS_DELIVER_BY_START_TIME = 4;

//! Deliver the last message per subject
const NATS_DELIVER_LAST_PER_SUBJECT = 5;
///@}

/** @defgroup nats_replay_policies NATS JetStream Replay Policies
    These constants define consumer replay policies.
*/
///@{
//! Replay messages as fast as possible
const NATS_REPLAY_INSTANT = 0;

//! Replay messages at the original delivery rate
const NATS_REPLAY_ORIGINAL = 1;
///@}

/** @defgroup nats_kv_operations NATS Key-Value Operations
    These constants define KV entry operation types.
*/
///@{
//! A put or update operation
const NATS_KV_OP_PUT = 1;

//! A delete operation
const NATS_KV_OP_DELETE = 2;

//! A purge operation
const NATS_KV_OP_PURGE = 3;
///@}

//! TLS options for NATS connections
/** @since %nats 1.0
*/
hashdecl Qore::Nats::NatsTlsOptions {
    //! Path to CA certificate file for server verification
    *string ca_cert;

    //! Path to client certificate file for mutual TLS
    *string client_cert;

    //! Path to client private key file for mutual TLS
    *string client_key;

    //! If True, skip server certificate verification (insecure)
    *bool skip_verify;

    //! TLS cipher list for TLSv1.2 and below (OpenSSL format)
    *string ciphers;

    //! TLS cipher suites for TLSv1.3 (OpenSSL format)
    *string cipher_suites;

    //! Expected hostname in the server certificate
    *string expected_hostname;

    //! If True, perform TLS handshake before NATS INFO protocol exchange
    *bool tls_handshake_first;
}

//! Connection options for NATS
/** @since %nats 1.0
*/
hashdecl Qore::Nats::NatsConnectionOptions {
    //! NATS server URL (e.g., "nats://localhost:4222")
    *string url;

    //! Authentication token
    *string token;

    //! Username for authentication
    *string username;

    //! Password for authentication
    *string password;

    //! Path to NKey seed file for authentication
    *string nkey_seed;

    //! Path to credentials file for authentication
    *string credentials;

    //! TLS configuration
    *hash<Qore::Nats::NatsTlsOptions> tls;

    //! Connection name (for server monitoring)
    *string name;

    //! Connection timeout in milliseconds
    *int connect_timeout_ms;

    //! Wait time between reconnection attempts in milliseconds
    *int reconnect_wait_ms;

    //! Maximum number of reconnection attempts (-1 = unlimited)
    *int max_reconnect;

    //! Interval between pings in milliseconds
    *int ping_interval;

    //! Maximum number of outstanding pings before connection is considered lost
    *int max_pings_out;

    //! If True, do not randomize server list for reconnection
    *bool no_randomize;

    //! List of NATS server URLs for cluster connections
    *list<string> servers;

    //! If True, the server will not echo messages back to the connection that published them
    *bool no_echo;

    //! If True, flush pending data after every publish (low-latency mode)
    *bool send_asap;

    //! If True, allow automatic reconnection (default: True)
    *bool allow_reconnect;

    //! Reconnect jitter in milliseconds for non-TLS connections
    *int reconnect_jitter_ms;

    //! Reconnect jitter in milliseconds for TLS connections
    *int reconnect_jitter_tls_ms;

    //! Size of the backing buffer used during reconnect (bytes)
    *int reconnect_buf_size;

    //! Maximum number of pending messages per subscription
    *int max_pending_msgs;

    //! Maximum number of pending bytes per subscription
    *int max_pending_bytes;

    //! If True, pending requests will fail immediately on disconnect
    *bool fail_requests_on_disconnect;

    //! IP resolution order: 0 = any, 4 = IPv4 only, 6 = IPv6 only, 46 = prefer IPv4, 64 = prefer IPv6
    *int ip_resolution_order;

    //! Write deadline in milliseconds (0 = no deadline)
    *int write_deadline_ms;

    //! If True, disable the "no responders" feature
    *bool disable_no_responders;

    //! Custom prefix for inbox subjects (default: "_INBOX")
    *string custom_inbox_prefix;

    //! Callback fired when the connection is disconnected
    *code on_disconnect;

    //! Callback fired when the connection is reconnected
    *code on_reconnect;

    //! Callback fired when the connection is permanently closed
    *code on_closed;

    //! Callback fired on async errors; receives a string error message argument
    *code on_error;

    //! Callback fired when the server enters lame duck mode
    *code on_lame_duck;

    //! Callback fired when new servers are discovered in the cluster
    *code on_discovered_servers;
}

//! Information about a received NATS message
/** @since %nats 1.0
*/
hashdecl Qore::Nats::NatsMsgInfo {
    //! The subject the message was published to
    string subject;

    //! The message payload as binary data
    *binary data;

    //! The reply subject (for request/reply pattern)
    *string reply;

    //! Message headers (NATS 2.2+)
    *hash<string, string> headers;
}

//! Configuration for a JetStream stream
/** @since %nats 1.0
*/
hashdecl Qore::Nats::NatsStreamConfig {
    //! Stream name
    *string name;

    //! List of subjects this stream listens on
    *list<string> subjects;

    //! Retention policy (one of @ref nats_retention_policies)
    *int retention;

    //! Maximum number of messages in the stream (-1 = unlimited)
    *int max_msgs;

    //! Maximum total bytes in the stream (-1 = unlimited)
    *int max_bytes;

    //! Maximum age of messages in milliseconds (0 = unlimited)
    *int max_age;

    //! Maximum size of a single message in bytes (-1 = unlimited)
    *int max_msg_size;

    //! Storage type (one of @ref nats_storage_types)
    *int storage;

    //! Number of replicas
    *int num_replicas;

    //! Discard policy (one of @ref nats_discard_policies)
    *int discard;

    //! Stream description
    *string description;

    //! Maximum number of messages per subject (-1 = unlimited)
    *int max_msgs_per_subject;

    //! Maximum number of consumers (-1 = unlimited)
    *int max_consumers;

    //! Duplicate message detection window in milliseconds
    *int duplicate_window_ms;

    //! If True, seal the stream (no new messages can be added)
    *bool sealed;

    //! If True, restrict the ability to delete messages
    *bool deny_delete;

    //! If True, restrict the ability to purge messages
    *bool deny_purge;

    //! If True, allow rollup headers to purge subjects
    *bool allow_rollup;

    //! If True, do not require acknowledgment of messages
    *bool no_ack;

    //! If True, allow direct access to messages (used by KV)
    *bool allow_direct;

    //! If True, allow direct access for mirrors
    *bool mirror_direct;

    //! If True, apply per-subject new-message discard semantics
    *bool discard_new_per_subject;
}

//! Configuration for a JetStream consumer
/** @since %nats 1.0
*/
hashdecl Qore::Nats::NatsConsumerConfig {
    //! Durable consumer name (empty for ephemeral consumers)
    *string durable_name;

    //! Subject to deliver messages to (push-based)
    *string deliver_subject;

    //! Deliver group name for load balancing
    *string deliver_group;

    //! Acknowledgment policy (one of @ref nats_ack_policies)
    *int ack_policy;

    //! Time to wait for acknowledgment in milliseconds
    *int ack_wait;

    //! Delivery policy (one of @ref nats_deliver_policies)
    *int deliver_policy;

    //! Start sequence number (for NATS_DELIVER_BY_START_SEQUENCE)
    *int opt_start_seq;

    //! Start time (for NATS_DELIVER_BY_START_TIME)
    *date opt_start_time;

    //! Replay policy (one of @ref nats_replay_policies)
    *int replay_policy;

    //! Filter by subject
    *string filter_subject;

    //! Maximum number of delivery attempts (-1 = unlimited)
    *int max_deliver;

    //! Maximum outstanding unacknowledged messages
    *int max_ack_pending;

    //! Consumer description
    *string description;

    //! Consumer name (for named consumers, alternative to durable_name)
    *string name;

    //! Redelivery backoff durations in milliseconds
    *list<int> back_off;

    //! Rate limit in bits per second
    *int rate_limit_bps;

    //! If True, enable flow control
    *bool flow_control;

    //! Heartbeat interval in milliseconds
    *int heartbeat_ms;

    //! If True, deliver only headers (no message bodies)
    *bool headers_only;

    //! Maximum pull batch size
    *int max_request_batch;

    //! Maximum pull request expiration in milliseconds
    *int max_request_expires_ms;

    //! Maximum pull request bytes
    *int max_request_max_bytes;

    //! Ephemeral consumer inactivity threshold in milliseconds
    *int inactive_threshold_ms;

    //! Number of replicas for the consumer
    *int num_replicas;

    //! If True, force memory storage for the consumer
    *bool memory_storage;

    //! Multiple filter subjects
    *list<string> filter_subjects;

    //! Sampling frequency as a percentage string (e.g., "100")
    *string sample_frequency;
}

//! Information about a JetStream stream
/** @since %nats 1.0
*/
hashdecl Qore::Nats::NatsStreamInfo {
    //! Stream configuration
    hash<Qore::Nats::NatsStreamConfig> config;

    //! Number of messages in the stream
    int messages;

    //! Total bytes in the stream
    int bytes;

    //! First sequence number
    int first_seq;

    //! Last sequence number
    int last_seq;

    //! Number of consumers
    int consumer_count;
}

//! Information about a JetStream consumer
/** @since %nats 1.0
*/
hashdecl Qore::Nats::NatsConsumerInfo {
    //! Consumer configuration
    hash<Qore::Nats::NatsConsumerConfig> config;

    //! Number of delivered messages
    int delivered;

    //! Number of messages pending acknowledgment
    int ack_pending;

    //! Number of redelivered messages
    int redelivered;

    //! Number of waiting pull requests
    int waiting;

    //! Number of pending messages
    int num_pending;
}

//! Acknowledgment result from a JetStream publish
/** @since %nats 1.0
*/
hashdecl Qore::Nats::NatsPubAck {
    //! The stream name the message was published to
    string stream;

    //! The sequence number assigned to the message
    int sequence;

    //! True if this was a duplicate message
    bool duplicate;
}

//! Configuration for a NATS Key-Value store bucket
/** @since %nats 1.0
*/
hashdecl Qore::Nats::NatsKVConfig {
    //! Bucket name
    *string bucket;

    //! Bucket description
    *string description;

    //! Maximum value size in bytes
    *int max_value_size;

    //! Number of historical values to keep per key
    *int history;

    //! Time-to-live for values in milliseconds (0 = unlimited)
    *int ttl;

    //! Maximum total bytes in the bucket
    *int max_bytes;

    //! Storage type (one of @ref nats_storage_types)
    *int storage;

    //! Number of replicas
    *int num_replicas;
}

//! A key-value entry from a NATS KV store
/** @since %nats 1.0
*/
hashdecl Qore::Nats::NatsKVEntry {
    //! The bucket name
    string bucket;

    //! The key
    string key;

    //! The value as binary data
    *binary value;

    //! The revision number
    int revision;

    //! When the entry was created/updated
    *date created;

    //! The operation type (one of @ref nats_kv_operations)
    int operation;
}

//! Connection statistics
/** @since %nats 1.0
*/
hashdecl Qore::Nats::NatsConnectionStats {
    //! Number of messages received
    int in_msgs;

    //! Number of bytes received
    int in_bytes;

    //! Number of messages sent
    int out_msgs;

    //! Number of bytes sent
    int out_bytes;

    //! Number of reconnections
    int reconnects;
}

//! Connection information
/** @since %nats 1.0
*/
hashdecl Qore::Nats::NatsConnectionInfo {
    //! The URL of the server currently connected to
    *string connected_url;

    //! The server ID of the connected server
    *string server_id;

    //! The client ID assigned by the server
    int client_id;

    //! The client IP address as seen by the server
    *string client_ip;

    //! Round-trip time to the server in milliseconds
    *int rtt_ms;

    //! Maximum payload size allowed by the server
    int max_payload;

    //! True if the server supports message headers
    bool has_header_support;

    //! The local IP address used for the connection
    *string local_ip;

    //! The local port used for the connection
    *int local_port;

    //! True if the connection is in the process of reconnecting
    bool is_reconnecting;

    //! True if the connection is in drain mode
    bool is_draining;

    //! Number of bytes buffered for write
    int buffered;

    //! List of known server URLs
    *list<string> servers;

    //! List of discovered server URLs (from cluster gossip)
    *list<string> discovered_servers;

    //! Connection statistics
    hash<Qore::Nats::NatsConnectionStats> stats;
}

//! JetStream message metadata
/** @since %nats 1.0
*/
hashdecl Qore::Nats::NatsJSMsgMetadata {
    //! The JetStream domain
    *string domain;

    //! The stream name
    string stream;

    //! The consumer name
    string consumer;

    //! Number of times this message has been delivered
    int num_delivered;

    //! The stream sequence number
    int stream_seq;

    //! The consumer sequence number
    int consumer_seq;

    //! Number of pending messages for this consumer
    int num_pending;

    //! Message timestamp
    *date timestamp;
}

//! JetStream publish options for controlling publish behavior
/** @since %nats 1.0
*/
hashdecl Qore::Nats::NatsJSPubOptions {
    //! Maximum time to wait for a publish response in milliseconds
    *int max_wait_ms;

    //! Message ID for de-duplication
    *string msg_id;

    //! Expected stream name for the publish
    *string expect_stream;

    //! Expected last message ID in the stream
    *string expect_last_msg_id;

    //! Expected last sequence number in the stream
    *int expect_last_seq;

    //! Expected last sequence number for the subject
    *int expect_last_subject_seq;

    //! If True, expect no messages exist for the subject
    *bool expect_no_message;
}

//! JetStream account limits
/** @since %nats 1.0
*/
hashdecl Qore::Nats::NatsJSAccountLimits {
    //! Maximum memory in bytes
    int max_memory;

    //! Maximum storage in bytes
    int max_storage;

    //! Maximum number of streams
    int max_streams;

    //! Maximum number of consumers
    int max_consumers;

    //! Maximum outstanding unacknowledged messages
    int max_ack_pending;

    //! Maximum bytes per memory stream
    int memory_max_stream_bytes;

    //! Maximum bytes per storage stream
    int storage_max_stream_bytes;

    //! If True, max bytes is required for streams
    bool max_bytes_required;
}

//! JetStream account information
/** @since %nats 1.0
*/
hashdecl Qore::Nats::NatsJSAccountInfo {
    //! Memory used in bytes
    int memory;

    //! Storage used in bytes
    int storage;

    //! Number of streams
    int streams;

    //! Number of consumers
    int consumers;

    //! JetStream domain
    *string domain;

    //! Total API calls
    int api_total;

    //! Total API errors
    int api_errors;

    //! Account limits
    hash<Qore::Nats::NatsJSAccountLimits> limits;
}

//! JetStream subscription options
/** @since %nats 1.0
*/
hashdecl Qore::Nats::NatsJSSubOptions {
    //! Bind to a specific stream name
    *string stream;

    //! Bind to an existing consumer by name
    *string consumer;

    //! Queue group name
    *string queue;

    //! If True, use manual acknowledgment mode
    *bool manual_ack;

    //! If True, create an ordered consumer (FIFO, no redelivery)
    *bool ordered;
}

//! Subscription statistics
/** @since %nats 1.0
*/
hashdecl Qore::Nats::NatsSubscriptionStats {
    //! The subscription subject
    *string subject;

    //! The subscription ID
    int id;

    //! Number of pending messages
    int pending_msgs;

    //! Number of pending bytes
    int pending_bytes;

    //! Number of delivered messages
    int delivered_msgs;

    //! Number of dropped messages
    int dropped_msgs;
}

//! Key-Value bucket status
/** @since %nats 1.0
*/
hashdecl Qore::Nats::NatsKVBucketStatus {
    //! Bucket name
    string bucket;

    //! Number of values in the bucket
    int values;

    //! Number of historical values to keep per key
    int history;

    //! Time-to-live in milliseconds (0 = unlimited)
    int ttl_ms;

    //! Number of replicas
    int replicas;

    //! Total bytes used by the bucket
    int bytes;
}

//! Options for KV watch operations
/** @since %nats 1.0
*/
hashdecl Qore::Nats::NatsKVWatchOptions {
    //! If True, do not receive delete/purge notifications
    *bool ignore_deletes;

    //! If True, only receive metadata (no values)
    *bool meta_only;

    //! If True, skip initial value snapshot and only receive updates
    *bool updates_only;
}
