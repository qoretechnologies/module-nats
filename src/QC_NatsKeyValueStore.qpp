#include "nats-module.h"
#include "QC_NatsKeyValueStore.h"

//! The NatsKeyValueStore class provides access to a NATS JetStream Key-Value store
/**
    @par Example: Key-Value operations
    @code{.py}
NatsConnection conn("nats://localhost:4222");
JetStreamContext js = conn.jetStream();
NatsKeyValueStore kv = js.createKeyValue(<NatsKVConfig>{
    "bucket": "config",
    "history": 5,
});

# Put and get values
int rev = kv.putString("app.name", "MyApp");
*hash<NatsKVEntry> entry = kv.get("app.name");
if (entry) {
    printf("Key: %s, Value: %s, Rev: %d\n", entry.key, entry.value.toString(), entry.revision);
}

# CAS update
int new_rev = kv.update("app.name", binary("NewApp"), rev);
    @endcode

    @note NatsKeyValueStore objects are created by @ref JetStreamContext::keyValue()
    or @ref JetStreamContext::createKeyValue() — not directly instantiated.

    @since %nats 1.0
*/
qclass NatsKeyValueStore [arg=QoreNatsKVStore* kv; ns=Qore::Nats; dom=NETWORK];

//! Puts a binary value for a key (creates or updates)
/** @param key the key name
    @param data the binary value
    @return the revision number

    @throw NATS-KV-ERROR if the put fails

    @since %nats 1.0
*/
int NatsKeyValueStore::put(string key, binary data) {
    return kv->put(key->c_str(), data->getPtr(), (int)data->size(), xsink);
}

//! Puts a string value for a key (creates or updates)
/** @param key the key name
    @param data the string value
    @return the revision number

    @throw NATS-KV-ERROR if the put fails

    @since %nats 1.0
*/
int NatsKeyValueStore::putString(string key, string data) {
    return kv->putString(key->c_str(), data->c_str(), xsink);
}

//! Creates a key with a value only if the key does not already exist
/** @param key the key name
    @param data the binary value
    @return the revision number

    @throw NATS-KV-ERROR if the key already exists or the operation fails

    @since %nats 1.0
*/
int NatsKeyValueStore::create(string key, binary data) {
    return kv->create(key->c_str(), data->getPtr(), (int)data->size(), xsink);
}

//! Updates a key with compare-and-swap semantics
/** Only succeeds if the current revision matches the given revision.

    @param key the key name
    @param data the new binary value
    @param revision the expected current revision
    @return the new revision number

    @throw NATS-KV-ERROR if the revision doesn't match or the operation fails

    @since %nats 1.0
*/
int NatsKeyValueStore::update(string key, binary data, int revision) {
    return kv->update(key->c_str(), data->getPtr(), (int)data->size(),
        (uint64_t)revision, xsink);
}

//! Gets the value for a key
/** @param key the key name
    @return a @ref NatsKVEntry hash, or @ref nothing if the key is not found

    @throw NATS-KV-ERROR if the get fails (other than not-found)

    @since %nats 1.0
*/
*hash<NatsKVEntry> NatsKeyValueStore::get(string key) {
    return kv->get(key->c_str(), xsink);
}

//! Soft-deletes a key (marks as deleted but retains history)
/** @param key the key name

    @throw NATS-KV-ERROR if the delete fails

    @since %nats 1.0
*/
nothing NatsKeyValueStore::delete(string key) {
    kv->del(key->c_str(), xsink);
}

//! Purges a key (removes all revisions)
/** @param key the key name

    @throw NATS-KV-ERROR if the purge fails

    @since %nats 1.0
*/
nothing NatsKeyValueStore::purge(string key) {
    kv->purge(key->c_str(), xsink);
}

//! Lists all keys in the bucket
/** @return a list of key names

    @throw NATS-KV-ERROR if the operation fails

    @since %nats 1.0
*/
list<string> NatsKeyValueStore::keys() {
    return kv->keys(xsink);
}

//! Gets the history of a key (all revisions)
/** @param key the key name
    @return a list of @ref NatsKVEntry hashes

    @throw NATS-KV-ERROR if the operation fails

    @since %nats 1.0
*/
list<hash<NatsKVEntry>> NatsKeyValueStore::history(string key) {
    return kv->history(key->c_str(), xsink);
}

//! Returns the bucket name
/** @return the name of this KV bucket

    @since %nats 1.0
*/
string NatsKeyValueStore::bucketName() [flags=RET_VALUE_ONLY] {
    return new QoreStringNode(kv->bucketName());
}
