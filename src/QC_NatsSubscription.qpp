#include "nats-module.h"
#include "QC_NatsSubscription.h"

//! The NatsSubscription class provides access to a NATS subscription
/**
    @par Example: Receiving messages
    @code{.py}
NatsConnection conn("nats://localhost:4222");
NatsSubscription sub = conn.subscribe("events.>");
while (*hash<NatsMsgInfo> msg = sub.nextMsg(5s)) {
    printf("Subject: %s, Data: %y\n", msg.subject, msg.data);
}
sub.unsubscribe();
    @endcode

    @note NatsSubscription objects are created by @ref NatsConnection::subscribe()
    or @ref NatsConnection::queueSubscribe() — not directly instantiated.

    @since %nats 1.0
*/
qclass NatsSubscription [arg=QoreNatsSubscription* sub; ns=Qore::Nats; dom=NETWORK];

//! Returns the next message from the subscription
/** Polls with 500ms intervals to support cooperative cancellation.

    @param timeout_ms timeout in milliseconds (default: 5000); -1 for infinite

    @return a @ref NatsMsgInfo hash, or @ref nothing on timeout

    @throw NATS-SUBSCRIBE-ERROR if the subscription is invalid or a receive error occurs

    @par Example:
    @code{.py}
*hash<NatsMsgInfo> msg = sub.nextMsg(10s);
if (msg) {
    printf("Got message on %s\n", msg.subject);
}
    @endcode

    @since %nats 1.0
*/
*hash<NatsMsgInfo> NatsSubscription::nextMsg(timeout timeout_ms = 5s) [flags=NAMED_ARGS] {
    return sub->nextMsg(timeout_ms, xsink);
}

//! Fetches messages from a pull subscription
/** @param batch the maximum number of messages to fetch
    @param timeout_ms the timeout for the fetch operation (default: 5 seconds)

    @return a list of @ref NatsMsgInfo hashes (may be empty on timeout)

    @throw NATS-SUBSCRIBE-ERROR if the fetch fails

    @par Example:
    @code{.py}
list<hash<NatsMsgInfo>> msgs = nsub.fetch(10, 5s);
foreach hash<NatsMsgInfo> msg in (msgs) {
    printf("Got: %s\n", msg.subject);
    nsub.ack();
}
    @endcode

    @since %nats 1.0
*/
list<hash<NatsMsgInfo>> NatsSubscription::fetch(int batch = 1, timeout timeout_ms = 5s) [flags=NAMED_ARGS] {
    return sub->fetch((int)batch, timeout_ms, xsink);
}

//! Unsubscribes from the subject
/** No more messages will be received after this call.

    @throw NATS-SUBSCRIBE-ERROR if the unsubscribe fails

    @since %nats 1.0
*/
nothing NatsSubscription::unsubscribe() {
    sub->unsubscribe(xsink);
}

//! Auto-unsubscribes after receiving the specified number of messages
/** @param max_messages the maximum number of messages to receive

    @throw NATS-SUBSCRIBE-ERROR if the operation fails

    @par Example:
    @code{.py}
sub.autoUnsubscribe(10);  # receive at most 10 messages
    @endcode

    @since %nats 1.0
*/
nothing NatsSubscription::autoUnsubscribe(int max_messages) [flags=NAMED_ARGS] {
    sub->autoUnsubscribe((int)max_messages, xsink);
}

//! Drains the subscription (processes pending messages then unsubscribes)
/** @throw NATS-SUBSCRIBE-ERROR if the drain fails

    @since %nats 1.0
*/
nothing NatsSubscription::drain() {
    sub->drain(xsink);
}

//! Waits for drain to complete
/** Blocks until the drain operation started by @ref drain() has completed
    or the timeout expires.

    @param timeout_ms maximum time to wait (default: 30 seconds)

    @throw NATS-SUBSCRIBE-ERROR if the wait fails or times out

    @par Example:
    @code{.py}
nsub.drain();
nsub.waitForDrainCompletion(10s);
    @endcode

    @since %nats 1.0
*/
nothing NatsSubscription::waitForDrainCompletion(timeout timeout_ms = 30s) [flags=NAMED_ARGS] {
    sub->waitForDrainCompletion(timeout_ms, xsink);
}

//! Returns True if the subscription is still valid
/** @return True if the subscription is active

    @since %nats 1.0
*/
bool NatsSubscription::isValid() [flags=RET_VALUE_ONLY] {
    return sub->isValid();
}

//! Returns the number of pending messages
/** @return the number of messages waiting to be received

    @throw NATS-SUBSCRIBE-ERROR if the query fails

    @since %nats 1.0
*/
int NatsSubscription::getPendingMsgs() {
    return sub->getPendingMsgs(xsink);
}

//! Acknowledges the last received JetStream message
/** @throw NATS-JETSTREAM-ERROR if there is no message to acknowledge or the ack fails

    @since %nats 1.0
*/
nothing NatsSubscription::ack() {
    sub->ack(xsink);
}

//! Negative-acknowledges the last received JetStream message (requests redelivery)
/** @throw NATS-JETSTREAM-ERROR if the nak fails

    @since %nats 1.0
*/
nothing NatsSubscription::nak() {
    sub->nak(xsink);
}

//! Signals that processing of the last JetStream message is still in progress
/** Resets the server's redelivery timer.

    @throw NATS-JETSTREAM-ERROR if the operation fails

    @since %nats 1.0
*/
nothing NatsSubscription::inProgress() {
    sub->inProgress(xsink);
}

//! Terminates delivery of the last JetStream message
/** The message will not be redelivered.

    @throw NATS-JETSTREAM-ERROR if the operation fails

    @since %nats 1.0
*/
nothing NatsSubscription::term() {
    sub->term(xsink);
}

//! Negative acknowledges the last received message with a redelivery delay
/** @param delay_ms the redelivery delay

    @throw NATS-SUBSCRIBE-ERROR if no message to acknowledge or the operation fails

    @since %nats 1.0
*/
nothing NatsSubscription::nakWithDelay(timeout delay_ms) [flags=NAMED_ARGS] {
    sub->nakWithDelay(delay_ms, xsink);
}

//! Returns JetStream metadata for the last received message
/** @return a @ref NatsJSMsgMetadata hash, or @ref nothing if no message or not a JetStream message

    @since %nats 1.0
*/
*hash<NatsJSMsgMetadata> NatsSubscription::getMetadata() [flags=RET_VALUE_ONLY] {
    return sub->getMetadata(xsink);
}

//! Returns the subscription subject
/** @return the subscription subject string

    @since %nats 1.0
*/
string NatsSubscription::getSubject() [flags=RET_VALUE_ONLY] {
    return new QoreStringNode(sub->getSubject());
}

//! Returns the subscription ID
/** @return the subscription ID

    @since %nats 1.0
*/
int NatsSubscription::getId() [flags=RET_VALUE_ONLY] {
    return sub->getId();
}

//! Returns pending message and byte counts
/** @return a hash with \c msgs (int) and \c bytes (int) keys

    @throw NATS-SUBSCRIBE-ERROR if the subscription is not valid

    @since %nats 1.0
*/
hash<auto> NatsSubscription::getPending() [flags=RET_VALUE_ONLY] {
    return sub->getPending(xsink);
}

//! Returns the number of delivered messages
/** @return the delivered message count

    @throw NATS-SUBSCRIBE-ERROR if the subscription is not valid

    @since %nats 1.0
*/
int NatsSubscription::getDelivered() [flags=RET_VALUE_ONLY] {
    return sub->getDelivered(xsink);
}

//! Returns the number of dropped messages
/** @return the dropped message count

    @throw NATS-SUBSCRIBE-ERROR if the subscription is not valid

    @since %nats 1.0
*/
int NatsSubscription::getDropped() [flags=RET_VALUE_ONLY] {
    return sub->getDropped(xsink);
}

//! Returns subscription statistics
/** @return a @ref NatsSubscriptionStats hash

    @throw NATS-SUBSCRIBE-ERROR if the subscription is not valid

    @since %nats 1.0
*/
hash<NatsSubscriptionStats> NatsSubscription::getSubscriptionStats() [flags=RET_VALUE_ONLY] {
    return sub->getSubscriptionStats(xsink);
}

//! Sets the maximum pending message and byte limits
/** @param message_limit maximum pending messages (-1 for no limit)
    @param bytes_limit maximum pending bytes (-1 for no limit)

    @throw NATS-SUBSCRIBE-ERROR if the subscription is not valid or the operation fails

    @since %nats 1.0
*/
nothing NatsSubscription::setPendingLimits(int message_limit, int bytes_limit) [flags=NAMED_ARGS] {
    sub->setPendingLimits((int)message_limit, (int)bytes_limit, xsink);
}
