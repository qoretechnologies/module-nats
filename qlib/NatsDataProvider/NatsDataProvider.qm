%modern
%allow-weak-references

%requires(reexport) DataProvider
%requires(reexport) ConnectionProvider
%requires nats
%requires NatsUtil

module NatsDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for NATS messaging";
    author = "Qore Technologies, s.r.o.";
    url = "https://github.com/qoretechnologies/module-nats";
    license = "MIT";
    init = sub () {
        # Register data provider factory
        DataProvider::registerFactory(new NatsDataProviderFactory());

        # Register connection schemes
        ConnectionSchemeCache::registerScheme("nats", NatsConnectionProvider::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("natss", NatsTlsConnectionProvider::ConnectionScheme);

        # Register app in action catalog
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": NatsDataProvider::AppName,
            "display_name": "NATS Server",
            "short_desc": "NATS messaging server",
            "desc": "NATS is a lightweight, high-performance messaging system for "
                "cloud-native applications.\n\n"
                "Supports publish/subscribe for event broadcasting, request/reply for "
                "synchronous microservice communication, and queue groups for "
                "load-balanced message processing across worker instances.",
            "scheme": "nats",
            "groups": (DataProvider::AppGroup::Messaging, DataProvider::AppGroup::ApiIntegration,),
            "logo": NatsLogo,
            "logo_mime_type": MimeTypeSvg,
            "logo_file_name": "nats-logo.svg",
        });

        # Register publish action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsDataProvider::AppName,
            "path": "/publish",
            "action": "publish",
            "display_name": "Publish Message",
            "short_desc": "Publish a fire-and-forget message to a NATS subject",
            "desc": "Publishes a message to the specified NATS subject using the "
                "fire-and-forget pattern.\n\n"
                "The message is delivered to all active subscribers on the `subject`. "
                "**No delivery confirmation** is provided; if no subscribers are "
                "listening, the message is silently discarded.",
            "action_code": DPAT_API,
            "groups": "Messaging",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsPublishRequestDataType::Fields{"subject",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                NatsPublishRequestDataType::Fields - ("subject",),
            ),
            "output_type": AbstractDataProviderTypeMap."nothing",
        });

        # Register request action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsDataProvider::AppName,
            "path": "/request",
            "action": "request",
            "display_name": "Request/Reply",
            "short_desc": "Send a synchronous request and wait for a reply",
            "desc": "Sends a synchronous request to a NATS subject and waits for a "
                "reply.\n\n"
                "Implements the request-reply pattern for microservice communication. "
                "A unique inbox is created automatically. The call blocks until a "
                "response arrives or `timeout_ms` expires.",
            "action_code": DPAT_API,
            "groups": "Messaging",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsRequestRequestDataType::Fields{"subject",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                NatsRequestRequestDataType::Fields - ("subject",),
            ),
            "output_type": NatsRequestDataProvider::ResponseType,
        });

        # Register subscribe event
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsDataProvider::AppName,
            "path": "/subscribe",
            "action": "subscribe",
            "display_name": "Subscribe to Messages",
            "short_desc": "Subscribe to real-time messages on a NATS subject",
            "desc": "Subscribes to messages on a NATS subject with observable event-based "
                "delivery.\n\n"
                "Supports wildcard subjects (`*` for single token, `>` for multi-token). "
                "Every active subscriber receives every matching message. For "
                "load-balanced delivery, use queue-subscribe instead.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_NATS_MESSAGE,
            "groups": "Messaging",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsSubscribeRequestDataType::Fields{"subject",}, {
                    "preselected": True,
                    "required": True,
                },
            ),
            "output_type": NatsMessageDataType,
        });

        # Register queue subscribe event
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsDataProvider::AppName,
            "path": "/queue-subscribe",
            "action": "queue-subscribe",
            "display_name": "Queue Subscribe",
            "short_desc": "Queue subscribe for load-balanced message delivery",
            "desc": "Subscribes to messages on a NATS subject with a queue group for "
                "load-balanced delivery.\n\n"
                "Each message is delivered to **exactly one** member of the queue group, "
                "enabling horizontal scaling of message processing across multiple "
                "worker instances without duplicate processing.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_NATS_MESSAGE,
            "groups": "Messaging",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsQueueSubscribeRequestDataType::Fields, {
                    "preselected": True,
                    "required": True,
                },
            ),
            "output_type": NatsMessageDataType,
        });
    };
}

/** @mainpage NatsDataProvider Module

    @tableofcontents

    @section natsdataproviderintro NatsDataProvider Module Introduction

    The %NatsDataProvider module integrates NATS messaging into Qore's data provider
    framework, enabling publish/subscribe, request/reply, and queue group messaging
    through a uniform API.

    Key capabilities:
    - <b>Publish</b>: send messages to subjects
    - <b>Request/Reply</b>: synchronous request/reply pattern
    - <b>Subscribe</b>: observable event-based message delivery
    - <b>Queue Subscribe</b>: load-balanced message delivery across consumers

    @subsection natsdataprovider_hierarchy Provider Hierarchy

    @verbatim
<root>
  ├── publish          (NatsPublishDataProvider — DPAT_API)
  ├── request          (NatsRequestDataProvider — DPAT_API)
  ├── subscribe        (NatsSubscribeEventDataProvider — DPAT_EVENT)
  └── queue-subscribe  (NatsQueueSubscribeEventDataProvider — DPAT_EVENT)
    @endverbatim

    @section natsdataprovider_connections Connection Schemes

    The module registers two connection URL schemes:
    - \c nats://host:port — plaintext NATS
    - \c natss://host:port — TLS-encrypted NATS

    @section natsdataprovider_relnotes Release Notes

    @subsection natsdataprovider_v1_0 NatsDataProvider v1.0
    - initial release
*/

#! Contains all public definitions in the NatsDataProvider module
public namespace NatsDataProvider {
    #! Application name for the data provider action catalog
    public const AppName = "NATS";

    #! NATS logo in SVG format for the action catalog
    public const NatsLogo = File::readTextFile(get_script_dir() + "/nats-logo.svg");
}
