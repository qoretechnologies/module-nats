%modern
%allow-weak-references

%requires(reexport) DataProvider
%requires(reexport) ConnectionProvider
%requires nats
%requires NatsUtil

module NatsJetStreamDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for NATS JetStream";
    author = "Qore Technologies, s.r.o.";
    url = "https://github.com/qoretechnologies/module-nats";
    license = "MIT";
    init = sub () {
        # Register data provider factory
        DataProvider::registerFactory(new NatsJetStreamDataProviderFactory());

        # Register app in action catalog
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": NatsJetStreamDataProvider::AppName,
            "display_name": "NATS JetStream",
            "short_desc": "NATS JetStream streaming and KV store",
            "desc": "NATS JetStream extends core NATS with persistent messaging, "
                "at-least-once delivery, and exactly-once semantics.\n\n"
                "Provides stream management for durable message storage, consumer "
                "management for delivery strategies, guaranteed publish with "
                "acknowledgments, and a distributed key-value store for configuration "
                "and shared state.",
            "scheme": "nats",
            "groups": (DataProvider::AppGroup::Messaging, DataProvider::AppGroup::ApiIntegration,),
            "logo": NatsJetStreamLogo,
            "logo_mime_type": MimeTypeSvg,
            "logo_file_name": "nats-logo.svg",
        });

        # Register actions for streams
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/streams/create",
            "action": "stream-create",
            "display_name": "Create Stream",
            "short_desc": "Create a JetStream stream for durable message storage",
            "desc": "Creates a new JetStream stream for durable message storage.\n\n"
                "Streams capture messages published to matching subjects and persist "
                "them according to configured retention policies. Use streams for "
                "message replay, audit trails, and guaranteed delivery.",
            "action_code": DPAT_API,
            "groups": "Streams",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSStreamConfigDataType::Fields{"name",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSStreamConfigDataType::Fields{"subjects",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSStreamConfigDataType::Fields - ("name", "subjects"),
            ),
            "output_type": NatsJSStreamCreateDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/streams/delete",
            "action": "stream-delete",
            "display_name": "Delete Stream",
            "short_desc": "Permanently delete a JetStream stream",
            "desc": "Permanently deletes a JetStream stream and all its messages.\n\n"
                "**Warning**: this removes the stream, all stored messages, and all "
                "associated consumers. This action cannot be undone.",
            "action_code": DPAT_API,
            "groups": "Streams",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSStreamDeleteRequestDataType::Fields, {
                    "preselected": True,
                    "required": True,
                },
            ),
            "output_type": AbstractDataProviderTypeMap."nothing",
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/streams/info",
            "action": "stream-info",
            "display_name": "Stream Info",
            "short_desc": "Get stream configuration and state information",
            "desc": "Retrieves configuration and state information for a JetStream "
                "stream.\n\n"
                "Returns the stream's subject filters, retention policy, storage "
                "limits, and current state including message count and byte size.",
            "action_code": DPAT_API,
            "groups": "Streams",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSStreamInfoRequestDataType::Fields, {
                    "preselected": True,
                    "required": True,
                },
            ),
            "output_type": NatsJSStreamInfoDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/streams/purge",
            "action": "stream-purge",
            "display_name": "Purge Stream",
            "short_desc": "Purge all messages from a stream",
            "desc": "Removes all messages from a JetStream stream while preserving "
                "its configuration.\n\n"
                "**Warning**: this permanently deletes all messages in the stream. "
                "The stream configuration and consumers are preserved, but consumer "
                "sequence positions are reset.",
            "action_code": DPAT_API,
            "groups": "Streams",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSStreamPurgeRequestDataType::Fields, {
                    "preselected": True,
                    "required": True,
                },
            ),
            "output_type": AbstractDataProviderTypeMap."nothing",
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/streams/list",
            "action": "stream-list",
            "display_name": "List Streams",
            "short_desc": "List all JetStream streams with configuration and state",
            "desc": "Lists all JetStream streams with their configuration and current "
                "state.\n\n"
                "Returns detailed information for each stream including subject filters, "
                "retention policy, storage limits, message count, and consumer count.",
            "action_code": DPAT_API,
            "groups": "Streams",
            "output_type": NatsJSStreamListDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/streams/names",
            "action": "stream-names",
            "display_name": "Stream Names",
            "short_desc": "List all JetStream stream names",
            "desc": "Lists all JetStream stream names without full configuration or "
                "state details.\n\n"
                "Use this for lightweight enumeration when you only need to check which "
                "streams exist.",
            "action_code": DPAT_API,
            "groups": "Streams",
            "output_type": NatsJSStreamNamesDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/streams/update",
            "action": "stream-update",
            "display_name": "Update Stream",
            "short_desc": "Update a JetStream stream configuration",
            "desc": "Updates the configuration of an existing JetStream stream.\n\n"
                "Modifies stream settings such as subject filters, retention policy, "
                "storage limits, and replication. Not all settings can be changed after "
                "creation.",
            "action_code": DPAT_API,
            "groups": "Streams",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSStreamConfigDataType::Fields{"name",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSStreamConfigDataType::Fields{"subjects",}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSStreamConfigDataType::Fields - ("name", "subjects"),
            ),
            "output_type": NatsJSStreamUpdateDataProvider::ResponseType,
        });

        # Register actions for consumers
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/consumers/create",
            "action": "consumer-create",
            "display_name": "Create Consumer",
            "short_desc": "Create a consumer for stream message processing",
            "desc": "Creates a new consumer on a JetStream stream for message "
                "processing.\n\n"
                "Consumers define how messages are delivered from a stream, including "
                "delivery policy, acknowledgment requirements, and retry behavior. "
                "Durable consumers survive client disconnects.",
            "action_code": DPAT_API,
            "groups": "Consumers",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSConsumerConfigDataType::Fields{"stream",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSConsumerConfigDataType::Fields{"durable_name", "ack_policy"}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSConsumerConfigDataType::Fields
                    - ("stream", "durable_name", "ack_policy"),
            ),
            "output_type": NatsJSConsumerCreateDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/consumers/delete",
            "action": "consumer-delete",
            "display_name": "Delete Consumer",
            "short_desc": "Delete a consumer from a JetStream stream",
            "desc": "Deletes a consumer from a JetStream stream.\n\n"
                "**Warning**: this permanently removes the consumer and its tracking "
                "state. Unacknowledged messages will not be redelivered.",
            "action_code": DPAT_API,
            "groups": "Consumers",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSConsumerDeleteRequestDataType::Fields, {
                    "preselected": True,
                    "required": True,
                },
            ),
            "output_type": AbstractDataProviderTypeMap."nothing",
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/consumers/info",
            "action": "consumer-info",
            "display_name": "Consumer Info",
            "short_desc": "Get consumer configuration and delivery state",
            "desc": "Retrieves configuration and delivery state for a JetStream "
                "consumer.\n\n"
                "Returns the consumer's ack policy, deliver policy, filter subject, "
                "and current state including pending messages and processing progress.",
            "action_code": DPAT_API,
            "groups": "Consumers",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSConsumerInfoRequestDataType::Fields, {
                    "preselected": True,
                    "required": True,
                },
            ),
            "output_type": NatsJSConsumerInfoDataProvider::ResponseType,
        });

        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/consumers/list",
            "action": "consumer-list",
            "display_name": "List Consumers",
            "short_desc": "List all consumers for a JetStream stream",
            "desc": "Lists all consumers for a JetStream stream with their configuration "
                "and delivery state.\n\n"
                "Returns detailed information for each consumer including delivery policy, "
                "acknowledgment settings, and processing progress.",
            "action_code": DPAT_API,
            "groups": "Consumers",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSConsumerListRequestDataType::Fields, {
                    "preselected": True,
                    "required": True,
                },
            ),
            "output_type": NatsJSConsumerListDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/consumers/names",
            "action": "consumer-names",
            "display_name": "Consumer Names",
            "short_desc": "List all consumer names for a JetStream stream",
            "desc": "Lists all consumer names for a JetStream stream without full "
                "configuration or state details.\n\n"
                "Use this for lightweight enumeration when you only need to check which "
                "consumers exist.",
            "action_code": DPAT_API,
            "groups": "Consumers",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSConsumerNamesRequestDataType::Fields, {
                    "preselected": True,
                    "required": True,
                },
            ),
            "output_type": NatsJSConsumerNamesDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/consumers/update",
            "action": "consumer-update",
            "display_name": "Update Consumer",
            "short_desc": "Update a JetStream consumer configuration",
            "desc": "Updates the configuration of an existing JetStream consumer.\n\n"
                "Modifies consumer settings such as acknowledgment policy, delivery "
                "policy, filter subject, and retry behavior. Not all settings can be "
                "changed after creation.",
            "action_code": DPAT_API,
            "groups": "Consumers",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSConsumerConfigDataType::Fields{"stream",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSConsumerConfigDataType::Fields{"durable_name", "ack_policy"}, {
                    "preselected": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSConsumerConfigDataType::Fields
                    - ("stream", "durable_name", "ack_policy"),
            ),
            "output_type": NatsJSConsumerUpdateDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/consumers/pause",
            "action": "consumer-pause",
            "display_name": "Pause Consumer",
            "short_desc": "Pause a JetStream consumer until a specified time",
            "desc": "Pauses a JetStream consumer until a specified time.\n\n"
                "A paused consumer stops receiving messages until the specified time, "
                "at which point delivery automatically resumes. Use this for maintenance "
                "windows or rate limiting.",
            "action_code": DPAT_API,
            "groups": "Consumers",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSConsumerPauseRequestDataType::Fields{"stream", "consumer"}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSConsumerPauseRequestDataType::Fields{"pause_until",}, {
                    "preselected": True,
                    "required": True,
                },
            ),
            "output_type": NatsJSConsumerPauseDataProvider::ResponseType,
        });

        # Register publish action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/publish",
            "action": "js-publish",
            "display_name": "JetStream Publish",
            "short_desc": "Publish with guaranteed delivery and acknowledgment",
            "desc": "Publishes a message to a JetStream subject with guaranteed "
                "delivery.\n\n"
                "Unlike basic NATS publish, the message is persisted to a stream and a "
                "publish acknowledgment is returned confirming storage with the "
                "`stream` name and `sequence` number.",
            "action_code": DPAT_API,
            "groups": "Messaging",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSPublishRequestDataType::Fields{"subject",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSPublishRequestDataType::Fields - ("subject",),
            ),
            "output_type": NatsJSPublishDataProvider::ResponseType,
        });

        # Register KV actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/kv/put",
            "action": "kv-put",
            "display_name": "KV Put",
            "short_desc": "Store a value for a key in a KV bucket",
            "desc": "Stores a value for a key in a JetStream KV bucket.\n\n"
                "Creates the key if it does not exist, or updates it with a new "
                "revision. Returns the new `revision` number for optimistic "
                "concurrency control.",
            "action_code": DPAT_API,
            "groups": "Key-Value",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSKVPutRequestDataType::Fields{"bucket", "key"}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSKVPutRequestDataType::Fields - ("bucket", "key"),
            ),
            "output_type": NatsJSKVPutDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/kv/get",
            "action": "kv-get",
            "display_name": "KV Get",
            "short_desc": "Retrieve a value and metadata for a key",
            "desc": "Retrieves the current value and metadata for a key from a "
                "JetStream KV bucket.\n\n"
                "Returns the latest revision including `value`, `revision`, `created` "
                "timestamp, and `operation` type.",
            "action_code": DPAT_API,
            "groups": "Key-Value",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSKVGetRequestDataType::Fields, {
                    "preselected": True,
                    "required": True,
                },
            ),
            "output_type": NatsJSKVGetDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/kv/delete",
            "action": "kv-delete",
            "display_name": "KV Delete",
            "short_desc": "Soft-delete a key from a KV bucket",
            "desc": "Soft-deletes a key from a JetStream KV bucket.\n\n"
                "Places a delete marker so the key no longer appears in listings or "
                "get operations. The key's revision history is preserved.",
            "action_code": DPAT_API,
            "groups": "Key-Value",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSKVDeleteRequestDataType::Fields, {
                    "preselected": True,
                    "required": True,
                },
            ),
            "output_type": AbstractDataProviderTypeMap."nothing",
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/kv/keys",
            "action": "kv-keys",
            "display_name": "KV Keys",
            "short_desc": "List all active keys in a KV bucket",
            "desc": "Lists all active keys in a JetStream KV bucket.\n\n"
                "Returns key names with current (non-deleted) values. Deleted or "
                "purged keys are excluded from the listing.",
            "action_code": DPAT_API,
            "groups": "Key-Value",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSKVKeysRequestDataType::Fields, {
                    "preselected": True,
                    "required": True,
                },
            ),
            "output_type": NatsJSKVKeysDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/kv/history",
            "action": "kv-history",
            "display_name": "KV History",
            "short_desc": "Get the complete revision history for a KV key",
            "desc": "Retrieves the complete revision history for a key in a JetStream "
                "KV bucket.\n\n"
                "Returns all revisions ordered from oldest to newest, including put, "
                "delete, and purge operations. Use this for audit trails and debugging "
                "configuration changes.",
            "action_code": DPAT_API,
            "groups": "Key-Value",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSKVHistoryRequestDataType::Fields, {
                    "preselected": True,
                    "required": True,
                },
            ),
            "output_type": NatsJSKVHistoryDataProvider::ResponseType,
        });

        # Register message actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/messages/get",
            "action": "message-get",
            "display_name": "Get Message",
            "short_desc": "Retrieve a message from a stream by sequence number",
            "desc": "Retrieves a message from a JetStream stream by sequence number.\n\n"
                "Returns the message payload, subject, and headers. Returns nothing if no "
                "message exists at the given sequence.",
            "action_code": DPAT_API,
            "groups": "Messages",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSStreamMsgRequestDataType::Fields, {
                    "preselected": True,
                    "required": True,
                },
            ),
            "output_type": NatsJSStreamGetMsgDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/messages/get-last",
            "action": "message-get-last",
            "display_name": "Get Last Message",
            "short_desc": "Get the last message for a subject from a stream",
            "desc": "Retrieves the last message for a subject from a JetStream stream.\n\n"
                "Returns the most recently published message on the specified subject. "
                "Returns nothing if no message exists for the subject.",
            "action_code": DPAT_API,
            "groups": "Messages",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSStreamMsgBySubjectRequestDataType::Fields, {
                    "preselected": True,
                    "required": True,
                },
            ),
            "output_type": NatsJSStreamGetLastMsgDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/messages/delete",
            "action": "message-delete",
            "display_name": "Delete Message",
            "short_desc": "Delete a message from a stream by sequence number",
            "desc": "Deletes a message from a JetStream stream by sequence number.\n\n"
                "The message data may still be recoverable from storage. For guaranteed "
                "data removal, use the erase action instead.",
            "action_code": DPAT_API,
            "groups": "Messages",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSStreamMsgRequestDataType::Fields, {
                    "preselected": True,
                    "required": True,
                },
            ),
            "output_type": AbstractDataProviderTypeMap."nothing",
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/messages/erase",
            "action": "message-erase",
            "display_name": "Erase Message",
            "short_desc": "Securely erase a message from a stream",
            "desc": "Securely erases a message from a JetStream stream by sequence "
                "number.\n\n"
                "Unlike delete, this overwrites the message data in storage for compliance "
                "with data protection regulations.",
            "action_code": DPAT_API,
            "groups": "Messages",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSStreamMsgRequestDataType::Fields, {
                    "preselected": True,
                    "required": True,
                },
            ),
            "output_type": AbstractDataProviderTypeMap."nothing",
        });

        # Register account action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/account-info",
            "action": "account-info",
            "display_name": "Account Info",
            "short_desc": "Get JetStream account resource usage and API statistics",
            "desc": "Retrieves JetStream account information including resource usage "
                "and API statistics.\n\n"
                "Returns memory and storage usage, stream and consumer counts, and API "
                "request totals. Use this for capacity planning and monitoring.",
            "action_code": DPAT_API,
            "groups": "Account",
            "output_type": NatsJSAccountInfoDataProvider::ResponseType,
        });

        # Register KV bucket management actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/kv/create-bucket",
            "action": "kv-create-bucket",
            "display_name": "KV Create Bucket",
            "short_desc": "Create a new KV store bucket",
            "desc": "Creates a new JetStream Key-Value store bucket.\n\n"
                "Creates a bucket with the specified configuration including history "
                "depth, TTL, storage type, and replication. Returns the initial bucket "
                "status.",
            "action_code": DPAT_API,
            "groups": "Key-Value",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSKVConfigRequestDataType::Fields{"bucket",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSKVConfigRequestDataType::Fields - ("bucket",),
            ),
            "output_type": NatsJSKVCreateBucketDataProvider::ResponseType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/kv/delete-bucket",
            "action": "kv-delete-bucket",
            "display_name": "KV Delete Bucket",
            "short_desc": "Permanently delete a KV store bucket",
            "desc": "Permanently deletes a JetStream Key-Value store bucket.\n\n"
                "**Warning**: this removes the bucket, all stored keys, and all revision "
                "history. This action cannot be undone.",
            "action_code": DPAT_API,
            "groups": "Key-Value",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSKVDeleteBucketRequestDataType::Fields, {
                    "preselected": True,
                    "required": True,
                },
            ),
            "output_type": AbstractDataProviderTypeMap."nothing",
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/kv/status",
            "action": "kv-status",
            "display_name": "KV Bucket Status",
            "short_desc": "Get status information for a KV bucket",
            "desc": "Retrieves status information for a JetStream KV bucket.\n\n"
                "Returns the bucket's key count, history depth, TTL, replica count, and "
                "total storage usage.",
            "action_code": DPAT_API,
            "groups": "Key-Value",
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                NatsJSKVStatusRequestDataType::Fields, {
                    "preselected": True,
                    "required": True,
                },
            ),
            "output_type": NatsJSKVStatusDataProvider::ResponseType,
        });

        # Register subscribe events
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/subscribe",
            "action": "subscribe",
            "display_name": "JetStream Subscribe",
            "short_desc": "Subscribe to JetStream messages with push delivery",
            "desc": "Subscribes to JetStream messages with push-based delivery for "
                "real-time event processing.\n\n"
                "Messages are pushed to the subscriber as they arrive in the stream. "
                "Includes JetStream metadata such as stream sequence numbers and "
                "timestamps.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_JS_MESSAGE,
            "groups": "Messaging",
            "output_type": NatsJSMessageDataType,
        });
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": NatsJetStreamDataProvider::AppName,
            "path": "/pull-subscribe",
            "action": "pull-subscribe",
            "display_name": "JetStream Pull Subscribe",
            "short_desc": "Pull subscribe with a durable consumer",
            "desc": "Subscribes to JetStream messages with pull-based delivery using "
                "a durable consumer.\n\n"
                "The client controls delivery rate by requesting message batches, "
                "providing natural backpressure. The `durable` consumer tracks the "
                "last acknowledged position across restarts.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_JS_MESSAGE,
            "groups": "Messaging",
            "output_type": NatsJSMessageDataType,
        });
    };
}

/** @mainpage NatsJetStreamDataProvider Module

    @tableofcontents

    @section natsjetstreamdataproviderintro NatsJetStreamDataProvider Module Introduction

    The %NatsJetStreamDataProvider module integrates NATS JetStream into Qore's data provider
    framework, enabling persistent messaging with stream management, consumer management,
    and key-value store capabilities through a uniform API.

    Key capabilities:
    - <b>Streams</b>: create, delete, get info, list, names, purge, and update JetStream streams
    - <b>Consumers</b>: create, delete, get info, list, names, pause, and update consumers
    - <b>Messages</b>: get, get-last, delete, and erase individual stream messages
    - <b>Publish</b>: publish messages with JetStream acknowledgment and publish options
    - <b>Subscribe</b>: push-based observable event delivery from JetStream
    - <b>Pull Subscribe</b>: pull-based observable event delivery from JetStream
    - <b>Key-Value</b>: put, get, delete, list keys, get history, create/delete buckets, and bucket status
    - <b>Account</b>: get account resource usage and API statistics

    @subsection natsjetstreamdataprovider_hierarchy Provider Hierarchy

    @verbatim
<root>
  ├── streams
  │   ├── create       (NatsJSStreamCreateDataProvider — DPAT_API)
  │   ├── delete       (NatsJSStreamDeleteDataProvider — DPAT_API)
  │   ├── info         (NatsJSStreamInfoDataProvider — DPAT_API)
  │   ├── list         (NatsJSStreamListDataProvider — DPAT_API)
  │   ├── names        (NatsJSStreamNamesDataProvider — DPAT_API)
  │   ├── purge        (NatsJSStreamPurgeDataProvider — DPAT_API)
  │   └── update       (NatsJSStreamUpdateDataProvider — DPAT_API)
  ├── consumers
  │   ├── create       (NatsJSConsumerCreateDataProvider — DPAT_API)
  │   ├── delete       (NatsJSConsumerDeleteDataProvider — DPAT_API)
  │   ├── info         (NatsJSConsumerInfoDataProvider — DPAT_API)
  │   ├── list         (NatsJSConsumerListDataProvider — DPAT_API)
  │   ├── names        (NatsJSConsumerNamesDataProvider — DPAT_API)
  │   ├── pause        (NatsJSConsumerPauseDataProvider — DPAT_API)
  │   └── update       (NatsJSConsumerUpdateDataProvider — DPAT_API)
  ├── messages
  │   ├── get          (NatsJSStreamGetMsgDataProvider — DPAT_API)
  │   ├── get-last     (NatsJSStreamGetLastMsgDataProvider — DPAT_API)
  │   ├── delete       (NatsJSStreamDeleteMsgDataProvider — DPAT_API)
  │   └── erase        (NatsJSStreamEraseMsgDataProvider — DPAT_API)
  ├── publish          (NatsJSPublishDataProvider — DPAT_API)
  ├── subscribe        (NatsJSSubscribeEventDataProvider — DPAT_EVENT)
  ├── pull-subscribe   (NatsJSPullSubscribeEventDataProvider — DPAT_EVENT)
  ├── kv
  │   ├── put          (NatsJSKVPutDataProvider — DPAT_API)
  │   ├── get          (NatsJSKVGetDataProvider — DPAT_API)
  │   ├── delete       (NatsJSKVDeleteDataProvider — DPAT_API)
  │   ├── keys         (NatsJSKVKeysDataProvider — DPAT_API)
  │   ├── history      (NatsJSKVHistoryDataProvider — DPAT_API)
  │   ├── create-bucket(NatsJSKVCreateBucketDataProvider — DPAT_API)
  │   ├── delete-bucket(NatsJSKVDeleteBucketDataProvider — DPAT_API)
  │   └── status       (NatsJSKVStatusDataProvider — DPAT_API)
  └── account-info     (NatsJSAccountInfoDataProvider — DPAT_API)
    @endverbatim

    @section natsjetstreamdataprovider_relnotes Release Notes

    @subsection natsjetstreamdataprovider_v1_0 NatsJetStreamDataProvider v1.0
    - initial release
*/

#! Contains all public definitions in the NatsJetStreamDataProvider module
public namespace NatsJetStreamDataProvider {
    #! Application name for the data provider action catalog
    public const AppName = "NATSJetStream";

    #! NATS JetStream logo in SVG format for the action catalog
    public const NatsJetStreamLogo = File::readTextFile(get_script_dir() + "/nats-logo.svg");
}
