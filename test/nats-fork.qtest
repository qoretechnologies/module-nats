    Software is furnished to do so, subject to the following conditions:

    The above copyright notice and this permission notice shall be included in
    all copies or substantial portions of the Software.

    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    Child processes created with fork() while NATS objects exist.  Only the forking thread exists in a child: the
    threads of the NATS C client (its library threads and the threads of each connection) remain in the parent, and
    the child shares the parent's connection sockets.  The child must neither wait for those threads nor change the
    parent's connections when it releases the objects of the parent.

    Each child exits with exit() and writes its result to a FIFO that it keeps open until it has exited: the parent
    reads until the end of the data, so it waits for the child's exit deterministically.  A child that waits forever
    makes the parent wait forever (the test runner's time limit is only a guard).
*/

%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../qlib"

%requires QUnit
%requires FsUtil
%requires nats
%requires ./NatsTestServer.qm

%exec-class NatsForkTest

public class NatsForkTest inherits QUnit::Test {
    private {
        *NatsTestServer server;
        string url;
    }

    #! the longest a test waits for a message; it is a guard against a hang, never an expected time
    const MessageTimeout = 60s;

    constructor() : QUnit::Test("nats fork test", "1.0", \ARGV) {
        addTestCase("a child closes and destroys a connection and a subscription of its parent", \connectionTest());
        addTestCase("a child destroys a microservice of its parent", \microTest());
        addTestCase("a child ends its script while a connection of its parent exists", \scriptEndTest());
        set_return_value(main());
    }

    globalSetUp() {
        if (NatsTestServer::available()) {
            server = new NatsTestServer();
            url = server.url;
        }
    }

    globalTearDown() {
        if (server) {
            server.stop();
        }
    }

    # the child closes the connection and destroys it and the subscription; closing and destroying the connection
    # waited forever for its threads, which do not exist in the child.  The parent's connection and subscription are
    # unchanged.
    connectionTest() {
        checkEnv();
        NatsConnection conn(url);
        NatsSubscription nsub = conn.subscribe("fork.connection");
        assertEq(binary("before"), roundTrip(conn, nsub, "fork.connection", "before"));
        assertEq("deleted", runChild(string sub () {
            conn.close();
            delete nsub;
            delete conn;
            return "deleted";
        }));
        assertEq(binary("after"), roundTrip(conn, nsub, "fork.connection", "after"));
        conn.close();
    }

    # the child destroys the microservice and its connection; the parent's service still answers requests
    microTest() {
        checkEnv();
        NatsConnection conn(url);
        NatsMicroService svc = conn.createMicroService(cast<hash<NatsMicroServiceConfig>>({
            "name": "fork-echo",
            "version": "1.0.0",
            "endpoint": cast<hash<NatsMicroEndpointConfig>>({
                "name": "echo",
                "subject": "fork.echo",
                "handler": *data sub (hash<auto> req) { return req.data; },
            }),
        }));
        assertEq(binary("before"), conn.request("fork.echo", binary("before"), MessageTimeout).data);
        assertEq("deleted", runChild(string sub () {
            delete svc;
            delete conn;
            return "deleted";
        }));
        assertEq(binary("after"), conn.request("fork.echo", binary("after"), MessageTimeout).data);
        svc.stop();
        conn.close();
    }

    # the child ends its script, which destroys the connection and deletes the module, while the parent's
    # connection is open; the script runs in another process, whose output, and the child's, is read until both
    # have exited
    scriptEndTest() {
        checkEnv();
        TmpFile script(NOTHING, ".q");
        script.file.write(sprintf("%%prepend-module-path \"%s\"\n", dirname(get_module_hash().nats.filename))
            + "%modern\n%requires nats\n"
            "Nats::NatsConnection conn(" + sprintf("%y", url) + ");\n"
            "Nats::NatsSubscription nsub = conn.subscribe(\"fork.script\");\n"
            "conn.flush();\n"
            "flush();\n"
            "if (!fork()) {\n"
            "    printf(\"child: done\\n\");\n"
            "} else {\n"
            "    printf(\"parent: done\\n\");\n"
            "}\n");
        script.file.close();
        string output = backquote(sprintf("%s --enable-debug %s 2>&1", shellQuote(QORE_ARGV[0]),
            shellQuote(script.path)));
        assertRegex("child: done", output);
        assertRegex("parent: done", output);
    }

    private checkEnv() {
        if (!Option::HAVE_FORK) {
            testSkip("fork() is not available");
        }
        if (!server) {
            testSkip("nats-server is not available");
        }
    }

    #! publishes the data and returns the data of the next message of the subscription
    private static binary roundTrip(NatsConnection conn, NatsSubscription nsub, string subject, string data) {
        conn.publish(subject, binary(data));
        conn.flush(MessageTimeout);
        return nsub.nextMsg(MessageTimeout).data;
    }

    #! runs the code in a child process created with fork() and returns its result
    /** The child writes the string that the code returns, or the code of the exception that it raises, to a FIFO and
        exits with exit() while it holds the FIFO open, so the parent reads the result until the child has exited.
    */
    private string runChild(code child) {
        TmpDir tmp("nats-fork-");
        string path = tmp.path + DirSep + "result";
        assertEq(0, mkfifo(path));
        # the child must not write the parent's buffered output again when it exits
        flush();
        int pid = fork();
        if (!pid) {
            # the child opens the FIFO first: if it ends before it has written its result, the parent reads to the
            # end of what it wrote
            File f();
            f.open2(path, O_WRONLY);
            string result;
            try {
                result = child();
            } catch (hash<ExceptionInfo> ex) {
                result = "exception: " + ex.err;
            }
            f.write(result);
            Qore::exit(0);
        }
        assertGt(0, pid);
        ReadOnlyFile f(path);
        string result;
        while (*binary data = f.readBinary(4096)) {
            result += data.toString();
        }
        return result;
    }

    private static string shellQuote(string arg) {
        return "'" + replace(arg, "'", "'\\''") + "'";
    }
}
