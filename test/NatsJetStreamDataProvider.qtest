%modern

%requires QUnit
%requires DataProvider
%requires nats
%requires NatsUtil
%requires NatsJetStreamDataProvider

%exec-class NatsJetStreamDataProviderTest

public class NatsJetStreamDataProviderTest inherits QUnit::Test {
    private {
        int port;
        string url;
        *int nats_pid;
        string pid_file;
    }

    constructor() : QUnit::Test("NatsJetStreamDataProviderTest", "1.0") {
        # Factory tests
        addTestCase("factory test", \factoryTest());

        # Provider hierarchy tests
        addTestCase("provider children test", \providerChildrenTest());
        addTestCase("streams children test", \streamsChildrenTest());
        addTestCase("consumers children test", \consumersChildrenTest());
        addTestCase("kv children test", \kvChildrenTest());
        addTestCase("messages children test", \messagesChildrenTest());

        # Stream CRUD tests
        addTestCase("stream create test", \streamCreateTest());
        addTestCase("stream info test", \streamInfoTest());
        addTestCase("stream purge test", \streamPurgeTest());
        addTestCase("stream delete test", \streamDeleteTest());

        # Consumer CRUD tests
        addTestCase("consumer create test", \consumerCreateTest());
        addTestCase("consumer info test", \consumerInfoTest());
        addTestCase("consumer delete test", \consumerDeleteTest());

        # JS publish tests
        addTestCase("js publish test", \jsPublishTest());

        # KV store tests
        addTestCase("kv put test", \kvPutTest());
        addTestCase("kv get test", \kvGetTest());
        addTestCase("kv delete test", \kvDeleteTest());
        addTestCase("kv keys test", \kvKeysTest());
        addTestCase("kv history test", \kvHistoryTest());

        # New stream actions
        addTestCase("stream list test", \streamListTest());
        addTestCase("stream names test", \streamNamesTest());
        addTestCase("stream update test", \streamUpdateTest());

        # New consumer actions
        addTestCase("consumer list test", \consumerListTest());
        addTestCase("consumer names test", \consumerNamesTest());
        addTestCase("consumer update test", \consumerUpdateTest());
        addTestCase("consumer pause test", \consumerPauseTest());

        # Message actions
        addTestCase("message get test", \messageGetTest());
        addTestCase("message get-last test", \messageGetLastTest());
        addTestCase("message delete test", \messageDeleteTest());
        addTestCase("message erase test", \messageEraseTest());

        # Account info
        addTestCase("account info test", \accountInfoTest());

        # KV bucket management
        addTestCase("kv create bucket test", \kvCreateBucketTest());
        addTestCase("kv delete bucket test", \kvDeleteBucketTest());
        addTestCase("kv status test", \kvStatusTest());

        # Publish with options
        addTestCase("js publish with options test", \jsPublishWithOptionsTest());

        # Negative tests
        addTestCase("stream info not found test", \streamInfoNotFoundTest());
        addTestCase("kv get not found test", \kvGetNotFoundTest());

        set_return_value(main());
    }

    private startServer() {
        port = 10000 + (rand() % 50000);
        pid_file = sprintf("/tmp/nats-jsdp-test-%d.pid", port);
        string cmd = sprintf("nats-server -p %d -a 127.0.0.1 --pid %s -js &", port, pid_file);
        system(cmd);
        # Wait for pid file
        for (int i = 0; i < 50; ++i) {
            if (is_file(pid_file)) {
                nats_pid = trim(ReadOnlyFile::readTextFile(pid_file)).toInt();
                break;
            }
            usleep(100000);
        }
        if (!nats_pid) {
            throw "NATS-TEST-ERROR",
                sprintf("nats-server (JetStream) failed to start on port %d", port);
        }
        url = sprintf("nats://127.0.0.1:%d", port);
    }

    private stopServer() {
        if (nats_pid) {
            kill(nats_pid, SIGTERM);
            # Wait for process to exit
            for (int i = 0; i < 50; ++i) {
                if (!is_file(sprintf("/proc/%d/status", nats_pid))) {
                    break;
                }
                usleep(100000);
            }
            nats_pid = NOTHING;
        }
        if (is_file(pid_file)) {
            unlink(pid_file);
        }
    }

    globalSetUp() {
        startServer();
    }

    globalTearDown() {
        stopServer();
    }

    # Helper to create a unique name
    private string uniqueName(string prefix) {
        return sprintf("%s_%d_%d", prefix, port, rand() % 100000);
    }

    # --- Factory tests ---

    factoryTest() {
        NatsJetStreamDataProviderFactory factory();
        assertEq("natsjetstream", factory.getName());

        # Create a provider from the factory
        AbstractDataProvider dp = factory.create({"url": url});
        assertEq("natsjetstream", dp.getName());
    }

    # --- Provider hierarchy tests ---

    providerChildrenTest() {
        NatsJetStreamDataProvider dp({"url": url});
        *list<string> children = dp.getChildProviderNames();
        assertEq(True, exists children);
        assertEq(8, children.size());
        assertTrue(inlist("streams", children));
        assertTrue(inlist("consumers", children));
        assertTrue(inlist("messages", children));
        assertTrue(inlist("publish", children));
        assertTrue(inlist("subscribe", children));
        assertTrue(inlist("pull-subscribe", children));
        assertTrue(inlist("kv", children));
        assertTrue(inlist("account-info", children));
    }

    streamsChildrenTest() {
        NatsJetStreamDataProvider dp({"url": url});
        AbstractDataProvider streams_dp = dp.getChildProvider("streams");
        *list<string> children = streams_dp.getChildProviderNames();
        assertEq(True, exists children);
        assertEq(7, children.size());
        assertTrue(inlist("create", children));
        assertTrue(inlist("delete", children));
        assertTrue(inlist("info", children));
        assertTrue(inlist("list", children));
        assertTrue(inlist("names", children));
        assertTrue(inlist("purge", children));
        assertTrue(inlist("update", children));
    }

    consumersChildrenTest() {
        NatsJetStreamDataProvider dp({"url": url});
        AbstractDataProvider consumers_dp = dp.getChildProvider("consumers");
        *list<string> children = consumers_dp.getChildProviderNames();
        assertEq(True, exists children);
        assertEq(7, children.size());
        assertTrue(inlist("create", children));
        assertTrue(inlist("delete", children));
        assertTrue(inlist("info", children));
        assertTrue(inlist("list", children));
        assertTrue(inlist("names", children));
        assertTrue(inlist("pause", children));
        assertTrue(inlist("update", children));
    }

    kvChildrenTest() {
        NatsJetStreamDataProvider dp({"url": url});
        AbstractDataProvider kv_dp = dp.getChildProvider("kv");
        *list<string> children = kv_dp.getChildProviderNames();
        assertEq(True, exists children);
        assertEq(8, children.size());
        assertTrue(inlist("put", children));
        assertTrue(inlist("get", children));
        assertTrue(inlist("delete", children));
        assertTrue(inlist("keys", children));
        assertTrue(inlist("history", children));
        assertTrue(inlist("create-bucket", children));
        assertTrue(inlist("delete-bucket", children));
        assertTrue(inlist("status", children));
    }

    messagesChildrenTest() {
        NatsJetStreamDataProvider dp({"url": url});
        AbstractDataProvider messages_dp = dp.getChildProvider("messages");
        *list<string> children = messages_dp.getChildProviderNames();
        assertEq(True, exists children);
        assertEq(4, children.size());
        assertTrue(inlist("get", children));
        assertTrue(inlist("get-last", children));
        assertTrue(inlist("delete", children));
        assertTrue(inlist("erase", children));
    }

    # --- Stream CRUD tests ---

    streamCreateTest() {
        NatsJetStreamDataProvider dp({"url": url});
        AbstractDataProvider create_dp = dp.getChildProvider("streams").getChildProvider("create");

        string stream_name = uniqueName("DPCR");
        auto result = create_dp.doRequest({
            "name": stream_name,
            "subjects": (stream_name + ".>",),
            "storage": NATS_STORAGE_MEMORY,
        });

        assertEq(stream_name, result.config.name);
        assertEq(0, result.messages);

        # Cleanup
        AbstractDataProvider delete_dp = dp.getChildProvider("streams").getChildProvider("delete");
        delete_dp.doRequest({"name": stream_name});
    }

    streamInfoTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string stream_name = uniqueName("DPIN");

        # Create stream first
        AbstractDataProvider create_dp = dp.getChildProvider("streams").getChildProvider("create");
        create_dp.doRequest({
            "name": stream_name,
            "subjects": (stream_name + ".>",),
            "storage": NATS_STORAGE_MEMORY,
        });

        # Get stream info via data provider
        AbstractDataProvider info_dp = dp.getChildProvider("streams").getChildProvider("info");
        auto result = info_dp.doRequest({"name": stream_name});

        assertEq(stream_name, result.config.name);
        assertEq(0, result.messages);
        assertEq(0, result.bytes);

        # Cleanup
        AbstractDataProvider delete_dp = dp.getChildProvider("streams").getChildProvider("delete");
        delete_dp.doRequest({"name": stream_name});
    }

    streamPurgeTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string stream_name = uniqueName("DPPU");
        string subject = stream_name + ".data";

        # Create stream
        AbstractDataProvider create_dp = dp.getChildProvider("streams").getChildProvider("create");
        create_dp.doRequest({
            "name": stream_name,
            "subjects": (stream_name + ".>",),
            "storage": NATS_STORAGE_MEMORY,
        });

        # Publish some messages via JetStream to the stream
        AbstractDataProvider pub_dp = dp.getChildProvider("publish");
        for (int i = 0; i < 5; ++i) {
            pub_dp.doRequest({
                "subject": subject,
                "string_data": string(i),
            });
        }

        # Verify messages exist
        AbstractDataProvider info_dp = dp.getChildProvider("streams").getChildProvider("info");
        auto info_before = info_dp.doRequest({"name": stream_name});
        assertEq(5, info_before.messages);

        # Purge via data provider
        AbstractDataProvider purge_dp = dp.getChildProvider("streams").getChildProvider("purge");
        purge_dp.doRequest({"name": stream_name});

        # Verify purge
        auto info_after = info_dp.doRequest({"name": stream_name});
        assertEq(0, info_after.messages);

        # Cleanup
        AbstractDataProvider delete_dp = dp.getChildProvider("streams").getChildProvider("delete");
        delete_dp.doRequest({"name": stream_name});
    }

    streamDeleteTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string stream_name = uniqueName("DPDE");

        # Create stream
        AbstractDataProvider create_dp = dp.getChildProvider("streams").getChildProvider("create");
        create_dp.doRequest({
            "name": stream_name,
            "subjects": (stream_name + ".>",),
            "storage": NATS_STORAGE_MEMORY,
        });

        # Delete via data provider
        AbstractDataProvider delete_dp = dp.getChildProvider("streams").getChildProvider("delete");
        delete_dp.doRequest({"name": stream_name});

        # Getting info on deleted stream should throw
        AbstractDataProvider info_dp = dp.getChildProvider("streams").getChildProvider("info");
        assertThrows("NATS-JETSTREAM-ERROR", sub () {
            info_dp.doRequest({"name": stream_name});
        });
    }

    # --- Consumer CRUD tests ---

    consumerCreateTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string stream_name = uniqueName("DPCC");

        # Create stream first
        AbstractDataProvider stream_create_dp = dp.getChildProvider("streams")
            .getChildProvider("create");
        stream_create_dp.doRequest({
            "name": stream_name,
            "subjects": (stream_name + ".>",),
            "storage": NATS_STORAGE_MEMORY,
        });

        # Create consumer via data provider
        string consumer_name = "dp-test-consumer";
        AbstractDataProvider consumer_create_dp = dp.getChildProvider("consumers")
            .getChildProvider("create");
        auto result = consumer_create_dp.doRequest({
            "stream": stream_name,
            "durable_name": consumer_name,
            "ack_policy": NATS_ACK_EXPLICIT,
        });

        assertEq(consumer_name, result.config.durable_name);

        # Cleanup
        AbstractDataProvider delete_dp = dp.getChildProvider("streams").getChildProvider("delete");
        delete_dp.doRequest({"name": stream_name});
    }

    consumerInfoTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string stream_name = uniqueName("DPCI");

        # Create stream
        AbstractDataProvider stream_create_dp = dp.getChildProvider("streams")
            .getChildProvider("create");
        stream_create_dp.doRequest({
            "name": stream_name,
            "subjects": (stream_name + ".>",),
            "storage": NATS_STORAGE_MEMORY,
        });

        # Create consumer
        string consumer_name = "dp-info-consumer";
        AbstractDataProvider consumer_create_dp = dp.getChildProvider("consumers")
            .getChildProvider("create");
        consumer_create_dp.doRequest({
            "stream": stream_name,
            "durable_name": consumer_name,
            "ack_policy": NATS_ACK_EXPLICIT,
        });

        # Get consumer info via data provider
        AbstractDataProvider consumer_info_dp = dp.getChildProvider("consumers")
            .getChildProvider("info");
