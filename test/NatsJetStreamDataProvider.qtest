    consumerDeleteTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string stream_name = uniqueName("DPCD");

        # Create stream
        AbstractDataProvider stream_create_dp = dp.getChildProvider("streams")
            .getChildProvider("create");
        stream_create_dp.doRequest({
            "name": stream_name,
            "subjects": (stream_name + ".>",),
            "storage": NATS_STORAGE_MEMORY,
        });

        # Create consumer
        string consumer_name = "dp-del-consumer";
        AbstractDataProvider consumer_create_dp = dp.getChildProvider("consumers")
            .getChildProvider("create");
        consumer_create_dp.doRequest({
            "stream": stream_name,
            "durable_name": consumer_name,
            "ack_policy": NATS_ACK_EXPLICIT,
        });

        # Delete consumer via data provider
        AbstractDataProvider consumer_delete_dp = dp.getChildProvider("consumers")
            .getChildProvider("delete");
        consumer_delete_dp.doRequest({
            "stream": stream_name,
            "consumer": consumer_name,
        });

        # Getting info on deleted consumer should throw
        AbstractDataProvider consumer_info_dp = dp.getChildProvider("consumers")
            .getChildProvider("info");
        assertThrows("NATS-JETSTREAM-ERROR", sub () {
            consumer_info_dp.doRequest({
                "stream": stream_name,
                "consumer": consumer_name,
            });
        });

        # Cleanup
        AbstractDataProvider delete_dp = dp.getChildProvider("streams").getChildProvider("delete");
