    # --- Account info test ---

    accountInfoTest() {
        NatsJetStreamDataProvider dp({"url": url});

        # Get account info via data provider
        AbstractDataProvider acct_dp = dp.getChildProvider("account-info");
        auto result = acct_dp.doRequest(NOTHING);

        assertEq(True, exists result);
        assertTrue(result.memory >= 0);
        assertTrue(result.storage >= 0);
        assertTrue(result.streams >= 0);
        assertTrue(result.consumers >= 0);
        assertTrue(result.api_total >= 0);
        assertTrue(result.api_errors >= 0);
    }

    # --- KV bucket management tests ---

    kvCreateBucketTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string bucket = uniqueName("dpcrbkt");

        # Create bucket via data provider
        AbstractDataProvider create_dp = dp.getChildProvider("kv").getChildProvider("create-bucket");
        auto result = create_dp.doRequest({
            "bucket": bucket,
            "history": 3,
            "storage": NATS_STORAGE_MEMORY,
        });

        assertEq(bucket, result.bucket);
        assertEq(3, result.history);
        assertEq(0, result.values);

        # Cleanup
        NatsClient client(url);
        JetStreamContext js = client.getConnection().jetStream();
        js.deleteKeyValue(bucket);
        client.close();
    }

    kvDeleteBucketTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string bucket = uniqueName("dpdelbkt");

        # Create bucket via direct API
        NatsClient client(url);
        JetStreamContext js = client.getConnection().jetStream();
        js.createKeyValue(<NatsKVConfig>{
            "bucket": bucket,
            "storage": NATS_STORAGE_MEMORY,
        });
        client.close();

        # Delete bucket via data provider
        AbstractDataProvider delete_dp = dp.getChildProvider("kv").getChildProvider("delete-bucket");
        delete_dp.doRequest({"bucket": bucket});

        # Attempting to open the deleted bucket should fail
        NatsClient client2(url);
        JetStreamContext js2 = client2.getConnection().jetStream();
        assertThrows("NATS-KV-ERROR", sub () {
            js2.keyValue(bucket);
        });
        client2.close();
    }

    kvStatusTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string bucket = uniqueName("dpkvst");

        # Create bucket and add some keys
        NatsClient client(url);
        JetStreamContext js = client.getConnection().jetStream();
        NatsKeyValueStore kv = js.createKeyValue(<NatsKVConfig>{
            "bucket": bucket,
            "storage": NATS_STORAGE_MEMORY,
            "history": 5,
        });
        kv.putString("key1", "val1");
        kv.putString("key2", "val2");

        # Get status via data provider
        AbstractDataProvider status_dp = dp.getChildProvider("kv").getChildProvider("status");
        auto result = status_dp.doRequest({"bucket": bucket});

        assertEq(bucket, result.bucket);
        assertEq(2, result.values);
        assertEq(5, result.history);
        assertEq(1, result.replicas);
        assertTrue(result.bytes > 0);

        # Cleanup
        js.deleteKeyValue(bucket);
        client.close();
    }

    # --- Publish with options test ---

    jsPublishWithOptionsTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string stream_name = uniqueName("DPJPO");
        string subject = stream_name + ".msg";

        # Create stream first
        AbstractDataProvider create_dp = dp.getChildProvider("streams").getChildProvider("create");
        create_dp.doRequest({
            "name": stream_name,
            "subjects": (stream_name + ".>",),
            "storage": NATS_STORAGE_MEMORY,
        });

        # Publish with msg_id for idempotent publishing
        AbstractDataProvider pub_dp = dp.getChildProvider("publish");
        auto ack1 = pub_dp.doRequest({
            "subject": subject,
            "string_data": "idempotent-msg",
            "msg_id": "unique-id-1",
        });

        assertEq(stream_name, ack1.stream);
        assertTrue(ack1.sequence > 0);
        assertFalse(ack1.duplicate);

        # Publish same msg_id again (should be duplicate)
        auto ack2 = pub_dp.doRequest({
            "subject": subject,
            "string_data": "idempotent-msg",
            "msg_id": "unique-id-1",
        });

        assertEq(ack1.sequence, ack2.sequence);
        assertTrue(ack2.duplicate);

        # Publish with expect_stream
        auto ack3 = pub_dp.doRequest({
            "subject": subject,
            "string_data": "expected-stream-msg",
            "expect_stream": stream_name,
        });
        assertEq(stream_name, ack3.stream);

        # Cleanup
        AbstractDataProvider delete_dp = dp.getChildProvider("streams").getChildProvider("delete");
        delete_dp.doRequest({"name": stream_name});
    }

    # --- Negative tests ---

    streamInfoNotFoundTest() {
        NatsJetStreamDataProvider dp({"url": url});
        AbstractDataProvider info_dp = dp.getChildProvider("streams").getChildProvider("info");

        assertThrows("NATS-JETSTREAM-ERROR", sub () {
            info_dp.doRequest({"name": "NONEXISTENT_STREAM"});
        });
    }

    kvGetNotFoundTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string bucket = uniqueName("dpkvnf");

        # Create empty KV bucket
        NatsClient client(url);
        JetStreamContext js = client.getConnection().jetStream();
        js.createKeyValue(<NatsKVConfig>{
            "bucket": bucket,
            "storage": NATS_STORAGE_MEMORY,
        });

        # Get non-existent key via data provider
        AbstractDataProvider get_dp = dp.getChildProvider("kv").getChildProvider("get");
        auto result = get_dp.doRequest({
            "bucket": bucket,
            "key": "nonexistent",
        });

        # Non-existent key should return NOTHING
        assertNothing(result);

        # Cleanup
        js.deleteKeyValue(bucket);
        client.close();
    }
}
