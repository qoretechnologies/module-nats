    consumerPauseTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string stream_name = uniqueName("DPCP");

        # Create stream
        AbstractDataProvider stream_create_dp = dp.getChildProvider("streams")
            .getChildProvider("create");
        stream_create_dp.doRequest({
            "name": stream_name,
            "subjects": (stream_name + ".>",),
            "storage": NATS_STORAGE_MEMORY,
        });

        # Create consumer
        AbstractDataProvider consumer_create_dp = dp.getChildProvider("consumers")
            .getChildProvider("create");
        consumer_create_dp.doRequest({
            "stream": stream_name,
            "durable_name": "pause-consumer",
            "ack_policy": NATS_ACK_EXPLICIT,
        });

        # Pause consumer via data provider (pause for 1 minute from now)
        AbstractDataProvider pause_dp = dp.getChildProvider("consumers").getChildProvider("pause");
        date pause_until = now_us() + 1m;
        auto result;
        try {
            result = pause_dp.doRequest({
                "stream": stream_name,
                "consumer": "pause-consumer",
                "pause_until": pause_until,
            });
        } catch (hash<ExceptionInfo> ex) {
            AbstractDataProvider delete_dp = dp.getChildProvider("streams").getChildProvider("delete");
            delete_dp.doRequest({"name": stream_name});
            if (ex.err == "NATS-JETSTREAM-ERROR" && ex.desc.find("Timeout") >= 0) {
                testSkip("NATS server does not support JetStream consumer pause");
                return;
            }
            rethrow;
        }

        assertTrue(result.paused);

        # Cleanup
        AbstractDataProvider delete_dp = dp.getChildProvider("streams").getChildProvider("delete");
        delete_dp.doRequest({"name": stream_name});
    }

    # --- Message action tests ---

    messageGetTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string stream_name = uniqueName("DPMG");
        string subject = stream_name + ".msg";

        # Create stream and publish a message
        AbstractDataProvider create_dp = dp.getChildProvider("streams").getChildProvider("create");
        create_dp.doRequest({
            "name": stream_name,
            "subjects": (stream_name + ".>",),
            "storage": NATS_STORAGE_MEMORY,
        });

        AbstractDataProvider pub_dp = dp.getChildProvider("publish");
        auto ack = pub_dp.doRequest({
            "subject": subject,
            "string_data": "test-message",
        });

        # Get message by sequence via data provider
        AbstractDataProvider get_dp = dp.getChildProvider("messages").getChildProvider("get");
        auto result = get_dp.doRequest({
            "stream": stream_name,
            "seq": ack.sequence,
        });

        assertEq(True, exists result);
        assertEq(subject, result.subject);
        assertEq("test-message", result.data.toString());

        # Cleanup
        AbstractDataProvider delete_dp = dp.getChildProvider("streams").getChildProvider("delete");
        delete_dp.doRequest({"name": stream_name});
    }

    messageGetLastTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string stream_name = uniqueName("DPMGL");
        string subject = stream_name + ".msg";

        # Create stream and publish multiple messages
        AbstractDataProvider create_dp = dp.getChildProvider("streams").getChildProvider("create");
        create_dp.doRequest({
            "name": stream_name,
            "subjects": (stream_name + ".>",),
            "storage": NATS_STORAGE_MEMORY,
        });

        AbstractDataProvider pub_dp = dp.getChildProvider("publish");
        pub_dp.doRequest({"subject": subject, "string_data": "first"});
        pub_dp.doRequest({"subject": subject, "string_data": "second"});
        pub_dp.doRequest({"subject": subject, "string_data": "third"});

        # Get last message for subject
        AbstractDataProvider get_last_dp = dp.getChildProvider("messages")
            .getChildProvider("get-last");
        auto result = get_last_dp.doRequest({
            "stream": stream_name,
            "subject": subject,
        });

        assertEq(True, exists result);
        assertEq(subject, result.subject);
        assertEq("third", result.data.toString());

        # Cleanup
        AbstractDataProvider delete_dp = dp.getChildProvider("streams").getChildProvider("delete");
        delete_dp.doRequest({"name": stream_name});
    }

    messageDeleteTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string stream_name = uniqueName("DPMD");
        string subject = stream_name + ".msg";

        # Create stream and publish a message
        AbstractDataProvider create_dp = dp.getChildProvider("streams").getChildProvider("create");
        create_dp.doRequest({
            "name": stream_name,
            "subjects": (stream_name + ".>",),
            "storage": NATS_STORAGE_MEMORY,
        });

        AbstractDataProvider pub_dp = dp.getChildProvider("publish");
        auto ack = pub_dp.doRequest({
            "subject": subject,
            "string_data": "delete-me",
        });

        # Delete message via data provider
        AbstractDataProvider del_dp = dp.getChildProvider("messages").getChildProvider("delete");
        del_dp.doRequest({
            "stream": stream_name,
            "seq": ack.sequence,
        });

        # The message should be gone (getMsg returns nothing for deleted)
        AbstractDataProvider get_dp = dp.getChildProvider("messages").getChildProvider("get");
        auto result = get_dp.doRequest({
            "stream": stream_name,
            "seq": ack.sequence,
        });
        assertNothing(result);

        # Cleanup
        AbstractDataProvider delete_dp = dp.getChildProvider("streams").getChildProvider("delete");
        delete_dp.doRequest({"name": stream_name});
    }

