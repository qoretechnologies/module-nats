    # --- JS publish tests ---

    jsPublishTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string stream_name = uniqueName("DPJP");
        string subject = stream_name + ".msg";

        # Create stream first
        AbstractDataProvider create_dp = dp.getChildProvider("streams").getChildProvider("create");
        create_dp.doRequest({
            "name": stream_name,
            "subjects": (stream_name + ".>",),
            "storage": NATS_STORAGE_MEMORY,
        });

        # Publish via data provider
        AbstractDataProvider pub_dp = dp.getChildProvider("publish");
        auto ack = pub_dp.doRequest({
            "subject": subject,
            "string_data": "js-dp-test",
        });

        assertEq(stream_name, ack.stream);
        assertTrue(ack.sequence > 0);
        assertFalse(ack.duplicate);

        # Publish with binary data
        auto ack2 = pub_dp.doRequest({
            "subject": subject,
            "data": binary("binary-js-dp"),
        });
        assertTrue(ack2.sequence > ack.sequence);

        # Cleanup
        AbstractDataProvider delete_dp = dp.getChildProvider("streams").getChildProvider("delete");
        delete_dp.doRequest({"name": stream_name});
    }

    # --- KV store tests ---

    kvPutTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string bucket = uniqueName("dpkvput");

        # Create KV bucket via direct JetStream API
        NatsClient client(url);
        JetStreamContext js = client.getConnection().jetStream();
        js.createKeyValue(<NatsKVConfig>{
            "bucket": bucket,
            "storage": NATS_STORAGE_MEMORY,
        });

        # Put via data provider
        AbstractDataProvider put_dp = dp.getChildProvider("kv").getChildProvider("put");
        auto result = put_dp.doRequest({
            "bucket": bucket,
            "key": "testkey",
            "string_data": "testvalue",
        });

        assertTrue(result.revision > 0);

        # Put with binary data
        auto result2 = put_dp.doRequest({
            "bucket": bucket,
            "key": "binkey",
            "data": binary("binvalue"),
        });
        assertTrue(result2.revision > 0);

        # Cleanup
        js.deleteKeyValue(bucket);
        client.close();
    }

    kvGetTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string bucket = uniqueName("dpkvget");

        # Create KV bucket and put a value
        NatsClient client(url);
        JetStreamContext js = client.getConnection().jetStream();
        NatsKeyValueStore kv = js.createKeyValue(<NatsKVConfig>{
            "bucket": bucket,
            "storage": NATS_STORAGE_MEMORY,
        });
        kv.putString("mykey", "myvalue");

        # Get via data provider
        AbstractDataProvider get_dp = dp.getChildProvider("kv").getChildProvider("get");
        auto result = get_dp.doRequest({
            "bucket": bucket,
            "key": "mykey",
        });

        assertEq(True, exists result);
        assertEq("mykey", result.key);
        assertEq("myvalue", result.value.toString());
        assertEq(bucket, result.bucket);
        assertTrue(result.revision > 0);

        # Cleanup
        js.deleteKeyValue(bucket);
        client.close();
    }

    kvDeleteTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string bucket = uniqueName("dpkvdel");

        # Create KV bucket and put a value
        NatsClient client(url);
        JetStreamContext js = client.getConnection().jetStream();
        NatsKeyValueStore kv = js.createKeyValue(<NatsKVConfig>{
            "bucket": bucket,
            "storage": NATS_STORAGE_MEMORY,
        });
        kv.putString("delkey", "to-delete");

        # Delete via data provider
        AbstractDataProvider delete_dp = dp.getChildProvider("kv").getChildProvider("delete");
        delete_dp.doRequest({
            "bucket": bucket,
            "key": "delkey",
        });

        # After soft delete, get may return NOTHING or a deleted marker
        *hash<NatsKVEntry> entry = kv.get("delkey");
        if (entry) {
            assertEq(NATS_KV_OP_DELETE, entry.operation);
        }

        # Cleanup
        js.deleteKeyValue(bucket);
        client.close();
    }

    kvKeysTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string bucket = uniqueName("dpkvkeys");

        # Create KV bucket and add keys
        NatsClient client(url);
        JetStreamContext js = client.getConnection().jetStream();
        NatsKeyValueStore kv = js.createKeyValue(<NatsKVConfig>{
            "bucket": bucket,
            "storage": NATS_STORAGE_MEMORY,
        });
        kv.putString("key1", "val1");
        kv.putString("key2", "val2");
        kv.putString("key3", "val3");

        # List keys via data provider
        AbstractDataProvider keys_dp = dp.getChildProvider("kv").getChildProvider("keys");
        auto result = keys_dp.doRequest({
            "bucket": bucket,
        });

        assertEq(True, exists result.keys);
        assertEq(3, result.keys.size());
        assertTrue(inlist("key1", result.keys));
        assertTrue(inlist("key2", result.keys));
        assertTrue(inlist("key3", result.keys));

        # Cleanup
        js.deleteKeyValue(bucket);
        client.close();
    }

    kvHistoryTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string bucket = uniqueName("dpkvhist");

        # Create KV bucket with history and put multiple revisions
        NatsClient client(url);
        JetStreamContext js = client.getConnection().jetStream();
        NatsKeyValueStore kv = js.createKeyValue(<NatsKVConfig>{
            "bucket": bucket,
            "storage": NATS_STORAGE_MEMORY,
            "history": 10,
        });
        kv.putString("hkey", "v1");
        kv.putString("hkey", "v2");
        kv.putString("hkey", "v3");

        # Get history via data provider
        AbstractDataProvider history_dp = dp.getChildProvider("kv").getChildProvider("history");
        auto result = history_dp.doRequest({
            "bucket": bucket,
            "key": "hkey",
        });

        assertEq(True, exists result.entries);
        assertEq(3, result.entries.size());

        # Revisions should be monotonically increasing
        assertTrue(result.entries[0].revision < result.entries[1].revision);
        assertTrue(result.entries[1].revision < result.entries[2].revision);

        # Values should match
        assertEq("v1", result.entries[0].value.toString());
        assertEq("v2", result.entries[1].value.toString());
        assertEq("v3", result.entries[2].value.toString());

        # Cleanup
        js.deleteKeyValue(bucket);
        client.close();
    }

    # --- Stream list/names/update tests ---

    streamListTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string stream_name = uniqueName("DPSLI");

        # Create stream
        AbstractDataProvider create_dp = dp.getChildProvider("streams").getChildProvider("create");
        create_dp.doRequest({
            "name": stream_name,
            "subjects": (stream_name + ".>",),
            "storage": NATS_STORAGE_MEMORY,
        });

        # List streams via data provider
        AbstractDataProvider list_dp = dp.getChildProvider("streams").getChildProvider("list");
        auto result = list_dp.doRequest(NOTHING);

        assertEq(True, exists result.streams);
        assertTrue(result.streams.size() >= 1);

        # Find our stream in the list
        bool found = False;
        foreach auto stream_info in (result.streams) {
            if (stream_info.config.name == stream_name) {
                found = True;
                break;
            }
        }
        assertTrue(found);

        # Cleanup
        AbstractDataProvider delete_dp = dp.getChildProvider("streams").getChildProvider("delete");
        delete_dp.doRequest({"name": stream_name});
    }

    streamNamesTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string stream_name = uniqueName("DPSNA");

        # Create stream
        AbstractDataProvider create_dp = dp.getChildProvider("streams").getChildProvider("create");
        create_dp.doRequest({
            "name": stream_name,
            "subjects": (stream_name + ".>",),
            "storage": NATS_STORAGE_MEMORY,
        });

        # List stream names via data provider
        AbstractDataProvider names_dp = dp.getChildProvider("streams").getChildProvider("names");
        auto result = names_dp.doRequest(NOTHING);

        assertEq(True, exists result.names);
        assertTrue(result.names.size() >= 1);
        assertTrue(inlist(stream_name, result.names));

        # Cleanup
        AbstractDataProvider delete_dp = dp.getChildProvider("streams").getChildProvider("delete");
        delete_dp.doRequest({"name": stream_name});
    }

    streamUpdateTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string stream_name = uniqueName("DPSUP");

        # Create stream
        AbstractDataProvider create_dp = dp.getChildProvider("streams").getChildProvider("create");
        create_dp.doRequest({
            "name": stream_name,
            "subjects": (stream_name + ".>",),
            "storage": NATS_STORAGE_MEMORY,
        });

        # Update stream via data provider (change description)
        AbstractDataProvider update_dp = dp.getChildProvider("streams").getChildProvider("update");
        auto result = update_dp.doRequest({
            "name": stream_name,
            "subjects": (stream_name + ".>",),
            "storage": NATS_STORAGE_MEMORY,
            "description": "Updated description",
        });

        assertEq(stream_name, result.config.name);
        assertEq("Updated description", result.config.description);

        # Cleanup
        AbstractDataProvider delete_dp = dp.getChildProvider("streams").getChildProvider("delete");
        delete_dp.doRequest({"name": stream_name});
    }

    # --- Consumer list/names/update/pause tests ---

    consumerListTest() {
        NatsJetStreamDataProvider dp({"url": url});

        string stream_name = uniqueName("DPCLI");

        # Create stream
        AbstractDataProvider stream_create_dp = dp.getChildProvider("streams")
            .getChildProvider("create");
        stream_create_dp.doRequest({
            "name": stream_name,
            "subjects": (stream_name + ".>",),
            "storage": NATS_STORAGE_MEMORY,
        });

        # Create consumers
        AbstractDataProvider consumer_create_dp = dp.getChildProvider("consumers")
            .getChildProvider("create");
        consumer_create_dp.doRequest({
            "stream": stream_name,
            "durable_name": "consumer1",
            "ack_policy": NATS_ACK_EXPLICIT,
        });
        consumer_create_dp.doRequest({
            "stream": stream_name,
            "durable_name": "consumer2",
            "ack_policy": NATS_ACK_EXPLICIT,
        });

        # List consumers via data provider
        AbstractDataProvider list_dp = dp.getChildProvider("consumers").getChildProvider("list");
        auto result = list_dp.doRequest({"stream": stream_name});

        assertEq(True, exists result.consumers);
        assertEq(2, result.consumers.size());

        # Cleanup
        AbstractDataProvider delete_dp = dp.getChildProvider("streams").getChildProvider("delete");
        delete_dp.doRequest({"name": stream_name});
    }

