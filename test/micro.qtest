%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"

%requires QUnit
%requires nats
%requires ./NatsTestServer.qm

%exec-class MicroTest

public class MicroTest inherits QUnit::Test {
    private {
        int port;
        string url;
        *NatsTestServer server;
    }

    constructor() : QUnit::Test("MicroTest", "1.0") {
        if (!NatsTestServer::available()) {
            addTestCase("process module dependency", sub () { testSkip("process module not available"); });
            set_return_value(main());
            return;
        }
        addTestCase("basic micro service test", \basicServiceTest());
        addTestCase("named arguments test", \namedArgumentTest());
        addTestCase("micro service info test", \serviceInfoTest());
        addTestCase("micro service stats test", \serviceStatsTest());
        addTestCase("micro group test", \groupTest());
        addTestCase("micro sub-group test", \subGroupTest());
        addTestCase("micro add endpoint test", \addEndpointTest());
        addTestCase("micro error handling test", \errorHandlingTest());
        addTestCase("micro string response test", \stringResponseTest());
        addTestCase("micro stop test", \stopTest());
        addTestCase("micro no endpoint test", \noEndpointTest());
        addTestCase("micro service destroyed with a request in flight", \destroyInFlightTest());

        # negative tests
        addTestCase("micro invalid config test", \invalidConfigTest());

        set_return_value(main());
    }

    private startServer() {
        if (!NatsTestServer::available()) {
            return;
        }
        server = new NatsTestServer();
        port = server.port;
        url = server.url;
    }

    private stopServer() {
        if (server) {
            server.stop();
        }
    }

    globalSetUp() {
        startServer();
    }

    globalTearDown() {
        stopServer();
    }

    namedArgumentTest() {
        NatsConnection conn(url: url);
        NatsMicroService svc = conn.createMicroService(config: cast<hash<NatsMicroServiceConfig>>({
            "name": "named-svc",
            "version": "1.0.0",
        }));

        NatsMicroGroup grp = svc.addGroup(prefix: "named");
        NatsMicroGroup v1 = grp.addGroup(prefix: "v1");
        v1.addEndpoint(config: cast<hash<NatsMicroEndpointConfig>>({
            "name": "echo",
            "subject": "echo",
            "handler": *data sub (hash<auto> req) { return req.data; },
        }));

        hash<NatsMsgInfo> reply = conn.request(subject: "named.v1.echo", data: binary("hello"), timeout_ms: 5s);
        assertEq(binary("hello"), reply.data);

        svc.stop();
        assertTrue(svc.isStopped());
        conn.close();
    }

    basicServiceTest() {
        NatsConnection conn(url);
        NatsMicroService svc = conn.createMicroService(cast<hash<NatsMicroServiceConfig>>({
            "name": "test-echo",
            "version": "1.0.0",
            "description": "Echo microservice",
            "endpoint": cast<hash<NatsMicroEndpointConfig>>({
                "name": "echo",
                "subject": "test.echo",
                "handler": *data sub (hash<auto> req) { return req.data; },
            }),
        }));

        assertFalse(svc.isStopped());

        # Send a request and verify echo
        hash<NatsMsgInfo> reply = conn.request("test.echo", binary("hello"), 5s);
        assertEq(binary("hello"), reply.data);

        svc.stop();
        assertTrue(svc.isStopped());
        conn.close();
    }

    #! requests that are queued for a service when it is destroyed are handled with valid handlers
    destroyInFlightTest() {
        NatsConnection conn(url);
        on_exit conn.close();
        Queue started();
        Queue go();
        Queue handled();
        NatsMicroService svc = conn.createMicroService(cast<hash<NatsMicroServiceConfig>>({
            "name": "in-flight",
            "version": "1.0.0",
            "endpoint": cast<hash<NatsMicroEndpointConfig>>({
                "name": "slow",
                "subject": "test.in-flight",
                "handler": *data sub (hash<auto> req) {
                    if (req.data == binary("first")) {
                        # a second request is queued behind this one: once the connection is flushed, the service
                        # connection has received it
                        conn.publish("test.in-flight", binary("second"));
                        conn.flush();
                        started.push(True);
                        go.get();
                    }
                    handled.push(req.data);
                    return binary("done");
                },
            }),
        }));

        Queue replies();
        background sub () {
            try {
                replies.push(conn.request("test.in-flight", binary("first"), 10s).data);
            } catch (hash<ExceptionInfo> ex) {
                replies.push(ex.err);
            }
        }();
        assertTrue(started.get(), "the first request is being handled");
        # the service is destroyed while it handles the first request and the second one is queued
        delete svc;
        go.push(True);
        assertEq(binary("done"), replies.get(), "the first request is answered");
        assertEq(binary("first"), handled.get());
        assertEq(binary("second"), handled.get(), "the queued request is handled");
    }

    serviceInfoTest() {
        NatsConnection conn(url);
        NatsMicroService svc = conn.createMicroService(cast<hash<NatsMicroServiceConfig>>({
            "name": "info-svc",
            "version": "2.0.0",
            "description": "Info test",
            "endpoint": cast<hash<NatsMicroEndpointConfig>>({
                "name": "ping",
                "subject": "test.info.ping",
                "handler": *data sub (hash<auto> req) { return "pong"; },
            }),
        }));

        hash<NatsMicroServiceInfo> info = svc.getInfo();
        assertEq("info-svc", info.name);
        assertEq("2.0.0", info.version);
        assertEq("Info test", info.description);
        assertTrue(info.id.size() > 0);
        assertTrue(exists info.endpoints);
        assertTrue(info.endpoints.size() >= 1);
        assertEq("ping", info.endpoints[0].name);

        svc.stop();
        conn.close();
    }

    serviceStatsTest() {
        NatsConnection conn(url);
        NatsMicroService svc = conn.createMicroService(cast<hash<NatsMicroServiceConfig>>({
            "name": "stats-svc",
            "version": "1.0.0",
            "endpoint": cast<hash<NatsMicroEndpointConfig>>({
                "name": "work",
                "subject": "test.stats.work",
                "handler": *data sub (hash<auto> req) { return "done"; },
            }),
        }));

        # Send some requests
        for (int i = 0; i < 3; ++i) {
            conn.request("test.stats.work", binary("job"), 5s);
        }

        hash<NatsMicroServiceStats> stats = svc.getStats();
        assertEq("stats-svc", stats.name);
        assertEq("1.0.0", stats.version);
        assertTrue(stats.id.size() > 0);
        assertTrue(exists stats.started);
        assertTrue(exists stats.endpoints);
        assertTrue(stats.endpoints.size() >= 1);
        assertEq(3, stats.endpoints[0].num_requests);
        assertEq(0, stats.endpoints[0].num_errors);
        assertTrue(stats.endpoints[0].processing_time_ns >= 0);

        svc.stop();
        conn.close();
    }

    groupTest() {
        NatsConnection conn(url);
        NatsMicroService svc = conn.createMicroService(cast<hash<NatsMicroServiceConfig>>({
            "name": "group-svc",
            "version": "1.0.0",
        }));

        NatsMicroGroup grp = svc.addGroup("api");
        grp.addEndpoint(cast<hash<NatsMicroEndpointConfig>>({
            "name": "hello",
            "subject": "hello",
            "handler": *data sub (hash<auto> req) { return "world"; },
        }));

        hash<NatsMsgInfo> reply = conn.request("api.hello", binary(""), 5s);
        assertEq("world", reply.data.toString());

        svc.stop();
        conn.close();
    }

    subGroupTest() {
        NatsConnection conn(url);
        NatsMicroService svc = conn.createMicroService(cast<hash<NatsMicroServiceConfig>>({
            "name": "subgroup-svc",
            "version": "1.0.0",
        }));

        NatsMicroGroup grp = svc.addGroup("api");
        NatsMicroGroup v2 = grp.addGroup("v2");
        v2.addEndpoint(cast<hash<NatsMicroEndpointConfig>>({
            "name": "users",
            "subject": "users",
            "handler": *data sub (hash<auto> req) { return "user-list"; },
        }));

        hash<NatsMsgInfo> reply = conn.request("api.v2.users", binary(""), 5s);
        assertEq("user-list", reply.data.toString());

        svc.stop();
        conn.close();
    }

    addEndpointTest() {
        NatsConnection conn(url);
        NatsMicroService svc = conn.createMicroService(cast<hash<NatsMicroServiceConfig>>({
            "name": "endpoint-svc",
            "version": "1.0.0",
        }));

        svc.addEndpoint(cast<hash<NatsMicroEndpointConfig>>({
            "name": "greet",
            "subject": "test.greet",
            "handler": *data sub (hash<auto> req) { return "hi"; },
        }));

        hash<NatsMsgInfo> reply = conn.request("test.greet", binary(""), 5s);
        assertEq("hi", reply.data.toString());

        # Check that the endpoint shows up in info
        hash<NatsMicroServiceInfo> info = svc.getInfo();
        assertTrue(info.endpoints.size() >= 1);

        svc.stop();
        conn.close();
    }

    errorHandlingTest() {
        NatsConnection conn(url);
        NatsMicroService svc = conn.createMicroService(cast<hash<NatsMicroServiceConfig>>({
            "name": "error-svc",
            "version": "1.0.0",
            "endpoint": cast<hash<NatsMicroEndpointConfig>>({
                "name": "fail",
                "subject": "test.fail",
                "handler": *data sub (hash<auto> req) {
                    throw "TEST-ERROR", "intentional error";
                },
            }),
        }));

        # The request should still get a response (NATS micro framework converts errors)
        hash<NatsMsgInfo> reply = conn.request("test.fail", binary(""), 5s);
        assertTrue(exists reply);

        # Check that error stats are recorded
        hash<NatsMicroServiceStats> stats = svc.getStats();
        assertEq(1, stats.endpoints[0].num_requests);
        assertEq(1, stats.endpoints[0].num_errors);
        assertTrue(stats.endpoints[0].last_error.size() > 0);

        svc.stop();
        conn.close();
    }

    stringResponseTest() {
        NatsConnection conn(url);
        NatsMicroService svc = conn.createMicroService(cast<hash<NatsMicroServiceConfig>>({
            "name": "string-svc",
            "version": "1.0.0",
            "endpoint": cast<hash<NatsMicroEndpointConfig>>({
                "name": "upper",
                "subject": "test.upper",
                "handler": *data sub (hash<auto> req) {
                    return req.data ? req.data.toString().upr() : "";
                },
            }),
        }));

        hash<NatsMsgInfo> reply = conn.request("test.upper", binary("hello world"), 5s);
        assertEq("HELLO WORLD", reply.data.toString());

        svc.stop();
        conn.close();
    }

    stopTest() {
        NatsConnection conn(url);
        NatsMicroService svc = conn.createMicroService(cast<hash<NatsMicroServiceConfig>>({
            "name": "stop-svc",
            "version": "1.0.0",
            "endpoint": cast<hash<NatsMicroEndpointConfig>>({
                "name": "noop",
                "subject": "test.stop.noop",
                "handler": *data sub (hash<auto> req) { return; },
            }),
        }));

        assertFalse(svc.isStopped());
        svc.stop();
        assertTrue(svc.isStopped());

        # Double stop should not crash
        svc.stop();
        assertTrue(svc.isStopped());

        conn.close();
    }

    noEndpointTest() {
        NatsConnection conn(url);

        # Service with no default endpoint, endpoints added later
        NatsMicroService svc = conn.createMicroService(cast<hash<NatsMicroServiceConfig>>({
            "name": "bare-svc",
            "version": "1.0.0",
            "description": "Service with no default endpoint",
        }));

        assertFalse(svc.isStopped());

        hash<NatsMicroServiceInfo> info = svc.getInfo();
        assertEq("bare-svc", info.name);

        svc.stop();
        conn.close();
    }

    invalidConfigTest() {
        NatsConnection conn(url);

        # Missing version should fail
        assertThrows("NATS-MICRO-ERROR", sub () {
            conn.createMicroService(cast<hash<NatsMicroServiceConfig>>({
                "name": "bad-svc",
            }));
        });

        conn.close();
    }
}
