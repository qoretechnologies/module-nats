    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
    DEALINGS IN THE SOFTWARE.

    qore#7875: the text of an exception that the module raises for a NATS error contains values that are not the
    module's own (a URL, a stream or service name that the caller gives, the server's error text); it is raised as
    text, so printf conversions in it are not interpreted.  Before the fix, a URL with "%s" conversions crashed the
    process when the connection failed.  A microservice that cnats refuses releases its state whether or not cnats
    calls its done handler later (run under valgrind: the state of a refused service was lost).
*/

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"

%requires QUnit
%requires nats
%requires ./NatsTestServer.qm

%exec-class NatsErrorFormatTest

#! printf conversions that read arguments; interpreted, they read memory that is not there
const Conversions = "%s%s%s%s%s%s%s%s%n";

public class NatsErrorFormatTest inherits QUnit::Test {
    private {
        *NatsTestServer server;
    }

    constructor() : QUnit::Test("NatsErrorFormatTest", "1.0") {
        addTestCase("a connection error keeps the conversions of its URL", \connectionErrorTest());
        addTestCase("a JetStream error keeps the conversions of its stream name", \jetStreamErrorTest());
        addTestCase("a microservice error keeps the conversions of its name", \microErrorTest());
        addTestCase("a microservice that cannot be added to a closed connection is refused",
            \microClosedConnectionTest());
        addTestCase("an endpoint that cnats would not release is refused by the module", \microEndpointRefusedTest());
        set_return_value(main());
    }

    globalSetUp() {
        if (NatsTestServer::available()) {
            server = new NatsTestServer(("-js",));
        }
    }

    globalTearDown() {
        if (server) {
            server.stop();
        }
    }

    #! no server listens on port 1: the connection fails, and its error names the URL
    connectionErrorTest() {
        string url = "nats://127.0.0.1:1/" + Conversions;
        hash<ExceptionInfo> ex;
        try {
            NatsConnection conn(url);
            assertTrue(False, "the connection fails");
        } catch (hash<ExceptionInfo> ex1) {
            ex = ex1;
        }
        assertEq("NATS-CONNECTION-ERROR", ex.err);
        assertRegex(Conversions, ex.desc, "the URL is in the error as given");
    }

    jetStreamErrorTest() {
        if (!server) {
            testSkip("no NATS server with JetStream is available");
        }
        NatsConnection conn(server.url);
        on_exit conn.close();
        JetStreamContext js = conn.jetStream();
        string name = "missing" + Conversions;
        hash<ExceptionInfo> ex;
        try {
            js.deleteStream(name);
            assertTrue(False, "deleting a stream that does not exist fails");
        } catch (hash<ExceptionInfo> ex1) {
            ex = ex1;
        }
        assertEq("NATS-JETSTREAM-ERROR", ex.err);
        assertRegex(Conversions, ex.desc, "the stream name is in the error as given");
    }

    microErrorTest() {
        if (!server) {
            testSkip("no NATS server is available");
        }
        NatsConnection conn(server.url);
        on_exit conn.close();
        # a service name may contain only letters, digits, '-' and '_': this one is refused
        string name = "svc" + Conversions;
        hash<ExceptionInfo> ex;
        try {
            conn.createMicroService(cast<hash<NatsMicroServiceConfig>>({
                "name": name,
                "version": "1.0.0",
            }));
            assertTrue(False, "a service with an invalid name is refused");
        } catch (hash<ExceptionInfo> ex1) {
            ex = ex1;
        }
        assertEq("NATS-MICRO-ERROR", ex.err);
        assertRegex(Conversions, ex.desc, "the service name is in the error as given");
    }

    #! cnats refuses the service after it is created and before it adds an endpoint: its done handler is never called
    microClosedConnectionTest() {
        if (!server) {
            testSkip("no NATS server is available");
        }
        NatsConnection conn(server.url);
        conn.close();
        hash<ExceptionInfo> ex;
        try {
            conn.createMicroService(cast<hash<NatsMicroServiceConfig>>({
                "name": "closed_svc",
                "version": "1.0.0",
            }));
            assertTrue(False, "a service cannot be added to a closed connection");
        } catch (hash<ExceptionInfo> ex1) {
            ex = ex1;
        }
        assertEq("NATS-MICRO-ERROR", ex.err);
        assertRegex("closed", ex.desc, "the error names the closed connection");
    }

    #! an endpoint that cnats would refuse after it made its subject, which it then does not release, is refused by the
    #! module (run under valgrind)
    microEndpointRefusedTest() {
        if (!server) {
            testSkip("no NATS server is available");
        }
        NatsConnection conn(server.url);
        on_exit conn.close();
        code handler = *data sub (hash<auto> req) {
            return req.data;
        };
        # each endpoint, and the text that the error has
        foreach list<auto> tc in ((
                ({"name": "no_handler", "subject": "refused.none"}, "requires a 'handler'"),
                ({"name": "bad name", "subject": "refused.bad", "handler": handler}, "invalid endpoint name 'bad name'"),
                # a valid subject, but an invalid name
                ({"name": "a.b", "handler": handler}, "invalid endpoint name 'a.b'"),
                ({"name": "", "subject": "refused.empty", "handler": handler}, "invalid endpoint name ''"),
            )) {
            hash<auto> endpoint = tc[0];
            hash<ExceptionInfo> ex;
            try {
                conn.createMicroService(cast<hash<NatsMicroServiceConfig>>({
                    "name": "refused_endpoint_svc",
                    "version": "1.0.0",
                    "endpoint": cast<hash<NatsMicroEndpointConfig>>(endpoint),
                }));
                assertTrue(False, endpoint.name + ": the service is refused");
            } catch (hash<ExceptionInfo> ex1) {
                ex = ex1;
            }
            assertEq("NATS-MICRO-ERROR", ex.err, endpoint.name);
            assertRegex(tc[1], ex.desc, endpoint.name + ": the error");
        }
        # an endpoint added to a service or a group is checked in the same way
        NatsMicroService svc = conn.createMicroService(cast<hash<NatsMicroServiceConfig>>({
            "name": "accepted_svc",
            "version": "1.0.0",
        }));
        assertFalse(svc.isStopped(), "a service is created on the connection afterwards");
        assertThrows("NATS-MICRO-ERROR", "requires a 'handler'", \svc.addEndpoint(),
            cast<hash<NatsMicroEndpointConfig>>({"name": "no_handler"}));
        NatsMicroGroup grp = svc.addGroup("grp");
        assertThrows("NATS-MICRO-ERROR", "invalid endpoint name", \grp.addEndpoint(),
            cast<hash<NatsMicroEndpointConfig>>({"name": "bad name", "handler": handler}));
    }
}
