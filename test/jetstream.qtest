    kvDeleteBucketTest() {
        NatsConnection conn(url);
        JetStreamContext js = conn.jetStream();

        string bucket = uniqueName("kvdelbkt");
        js.createKeyValue(<NatsKVConfig>{
            "bucket": bucket,
            "storage": NATS_STORAGE_MEMORY,
        });

        js.deleteKeyValue(bucket);

        # Opening deleted bucket should throw
        assertThrows("NATS-KV-ERROR", sub () {
            js.keyValue(bucket);
        });

        conn.close();
    }

