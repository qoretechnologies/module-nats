            "durable_name": "cons2",
            "ack_policy": NATS_ACK_EXPLICIT,
        }));

        # List consumer names
        list<string> names = js.listConsumerNames(stream);
        assertEq(2, names.size());
        assertTrue(inlist("cons1", names));
        assertTrue(inlist("cons2", names));

        # List consumer info
        list<hash<NatsConsumerInfo>> consumers = js.listConsumers(stream);
        assertEq(2, consumers.size());

        js.deleteStream(stream);
        conn.close();
    }

    updateConsumerTest() {
        NatsConnection conn(url);
        JetStreamContext js = conn.jetStream();

        string stream = uniqueName("UCON");
        js.addStream(cast<hash<NatsStreamConfig>>({
            "name": stream,
            "subjects": (stream + ".>",),
            "storage": NATS_STORAGE_MEMORY,
        }));

        js.addConsumer(stream, cast<hash<NatsConsumerConfig>>({
            "durable_name": "upd-test",
            "ack_policy": NATS_ACK_EXPLICIT,
            "description": "original",
        }));

        hash<NatsConsumerInfo> updated = js.updateConsumer(stream,
            cast<hash<NatsConsumerConfig>>({
                "durable_name": "upd-test",
                "ack_policy": NATS_ACK_EXPLICIT,
                "description": "updated",
            }));
        assertEq("updated", updated.config.description);

        # Verify via getConsumerInfo too
        hash<NatsConsumerInfo> info = js.getConsumerInfo(stream, "upd-test");
        assertEq("updated", info.config.description);

        js.deleteStream(stream);
        conn.close();
    }

    getStreamMsgTest() {
        NatsConnection conn(url);
        JetStreamContext js = conn.jetStream();

        string stream = uniqueName("GMSG");
        js.addStream(cast<hash<NatsStreamConfig>>({
            "name": stream,
            "subjects": (stream + ".>",),
            "storage": NATS_STORAGE_MEMORY,
            "allow_direct": True,
        }));

        hash<NatsPubAck> ack = js.publish(stream + ".test", binary("msg-by-seq"));

        # Get by sequence
        *hash<NatsMsgInfo> msg = js.getMsg(stream, ack.sequence);
        assertEq(True, exists msg);
        assertEq("msg-by-seq", msg.data.toString());

        # Get last message for subject
        js.publish(stream + ".test", binary("last-msg"));
        *hash<NatsMsgInfo> last = js.getLastMsg(stream, stream + ".test");
        assertEq(True, exists last);
        assertEq("last-msg", last.data.toString());

        # Get non-existent sequence returns NOTHING
        *hash<NatsMsgInfo> missing = js.getMsg(stream, 99999);
        assertNothing(missing);

        js.deleteStream(stream);
        conn.close();
    }

    deleteStreamMsgTest() {
        NatsConnection conn(url);
        JetStreamContext js = conn.jetStream();

        string stream = uniqueName("DMSG");
        js.addStream(cast<hash<NatsStreamConfig>>({
            "name": stream,
            "subjects": (stream + ".>",),
            "storage": NATS_STORAGE_MEMORY,
            "allow_direct": True,
        }));

        hash<NatsPubAck> ack = js.publish(stream + ".test", binary("to-delete"));

        # Delete message
        js.deleteMsg(stream, ack.sequence);

        # Verify deleted - message should be gone
        *hash<NatsMsgInfo> msg = js.getMsg(stream, ack.sequence);
        assertNothing(msg);

        # Test eraseMsg
        hash<NatsPubAck> ack2 = js.publish(stream + ".test", binary("to-erase"));
        js.eraseMsg(stream, ack2.sequence);
        *hash<NatsMsgInfo> erased = js.getMsg(stream, ack2.sequence);
        assertNothing(erased);

        js.deleteStream(stream);
        conn.close();
    }

    orderedConsumerTest() {
        NatsConnection conn(url);
        JetStreamContext js = conn.jetStream();

        string stream = uniqueName("OCON");
        js.addStream(cast<hash<NatsStreamConfig>>({
            "name": stream,
            "subjects": (stream + ".>",),
            "storage": NATS_STORAGE_MEMORY,
        }));

        # Publish messages
        for (int i = 0; i < 5; ++i) {
            js.publish(stream + ".ordered", binary("msg-" + string(i)));
        }

        # Subscribe with ordered option
        NatsSubscription nsub = js.subscribeWithOptions(stream + ".ordered",
            cast<hash<NatsJSSubOptions>>({"ordered": True, "stream": stream}));

        # Should receive messages in order
        for (int i = 0; i < 5; ++i) {
            *hash<NatsMsgInfo> msg = nsub.nextMsg(5s);
            assertEq(True, exists msg);
            assertEq("msg-" + string(i), msg.data.toString());
        }

        nsub.unsubscribe();
        js.deleteStream(stream);
        conn.close();
    }
}
