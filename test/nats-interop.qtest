    NATS cross-client interoperability test suite

    Uses the official nats CLI (https://github.com/nats-io/natscli) as a
    known-good reference client to verify wire-protocol compatibility of the
    Qore NATS module.  Every test exercises a cross-client path: one side is
    the Qore module, the other is the nats CLI.
*/

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"

%requires QUnit
%requires nats
%requires NatsUtil

# the nats CLI processes are run with the process module
%try-module process >= 2.2
%define NoProcess
%endtry

%requires ./NatsTestServer.qm

%exec-class NatsInteropTest

public class NatsInteropTest inherits QUnit::Test {
    private {
        int port;
        string url;
        bool cli_available = False;
        *NatsTestServer server;
    }

    constructor() : QUnit::Test("NatsInteropTest", "1.0") {
%ifdef NoProcess
        addTestCase("process module dependency", \missingProcessModule());
        set_return_value(main());
        return;
%endif
        # Verify the nats CLI is available before registering tests
        if (system("command -v nats > /dev/null 2>&1")) {
            addTestCase("NATS CLI dependency", \missingCli());
            set_return_value(main());
            return;
        }
        cli_available = True;

        # --- Core NATS interop ---
        addTestCase("cli pub qore sub", \cliPubQoreSubTest());
        addTestCase("qore pub cli sub", \qorePubCliSubTest());
        addTestCase("cli request qore reply", \cliRequestQoreReplyTest());
        addTestCase("qore request cli reply", \qoreRequestCliReplyTest());
        addTestCase("cli pub with headers qore sub", \cliHeadersQoreSubTest());
        addTestCase("qore pub with headers cli sub", \qoreHeadersCliSubTest());

        # --- JetStream interop ---
        addTestCase("qore js pub cli consume", \qoreJsPubCliConsumeTest());
        addTestCase("cli pub qore js consume", \cliPubQoreJsConsumeTest());

        # --- KV store interop ---
        addTestCase("qore kv put cli get", \qoreKvPutCliGetTest());
        addTestCase("cli kv put qore get", \cliKvPutQoreGetTest());

        set_return_value(main());
    }

    private startServer() {
        server = new NatsTestServer(("-js",));
        port = server.port;
        url = server.url;
    }

    private stopServer() {
        if (server) {
            server.stop();
        }
    }

%ifndef NoProcess
    #! Starts the nats CLI with the given arguments and the server URL
    private Process startCli(list<string> args) {
        return new Process("nats", args + ("-s", url));
    }

    #! Waits for a nats CLI process to exit and returns its standard output
    /** If it does not exit in time, it is terminated, so that no test waits for it
    */
    private string waitCli(Process cli, timeout timeout_ms = 10s) {
        if (!cli.wait(timeout_ms)) {
            cli.terminate();
            cli.wait();
            throw "NATS-TEST-ERROR", sprintf("the nats CLI did not exit within %d ms", timeout_ms);
        }
        return cli.readStdout(1024 * 1024) ?? "";
    }
%endif

    globalSetUp() {
        if (cli_available) {
            startServer();
        }
    }

    globalTearDown() {
        if (cli_available) {
            stopServer();
        }
    }

    private nothing missingCli() {
        testSkip("nats CLI not available");
    }

    private nothing missingProcessModule() {
        testSkip("process module not available");
    }

    private string natsCmd(string args) {
        return sprintf("nats %s -s %s", args, url);
    }

    private string uniqueName(string prefix) {
        return sprintf("%s_%d_%d", prefix, port, rand() % 100000);
    }

    # ----------------------------------------------------------------
    # Core NATS: nats CLI publishes, Qore subscribes
    # ----------------------------------------------------------------
    cliPubQoreSubTest() {
        NatsConnection conn(url);
        NatsSubscription nsub = conn.subscribe("interop.cli-to-qore");
        conn.flush();

        # CLI publishes
        system(natsCmd("pub interop.cli-to-qore 'hello from nats cli'"));

        *hash<NatsMsgInfo> msg = nsub.nextMsg(5s);
        assertEq(True, exists msg);
        assertEq("interop.cli-to-qore", msg.subject);
        assertEq("hello from nats cli", msg.data.toString());

        nsub.unsubscribe();
        conn.close();
    }

    # ----------------------------------------------------------------
    # Core NATS: Qore publishes, nats CLI subscribes (--raw --count=1)
    # ----------------------------------------------------------------
    qorePubCliSubTest() {
%ifndef NoProcess
        # Start the CLI subscriber and wait until its subscription is active
        Process cli = startCli(("sub", "interop.qore-to-cli", "--count=1", "--raw", "--timeout=10s"));
        on_exit if (cli.running()) {
            cli.terminate();
            cli.wait();
        }
        server.waitForSubscription("interop.qore-to-cli");

        # Qore publishes
        NatsConnection conn(url);
        conn.publishString("interop.qore-to-cli", "hello from qore");
        conn.flush();
        conn.close();

        assertEq("hello from qore", trim(waitCli(cli)));
%endif
    }

    # ----------------------------------------------------------------
    # Core NATS: nats CLI sends request, Qore replies
    # ----------------------------------------------------------------
    cliRequestQoreReplyTest() {
        # Set up Qore responder
        NatsConnection conn(url);
        NatsSubscription nsub = conn.subscribe("interop.cli-request");
        conn.flush();

        Counter responder_cnt(1);
        background qoreResponder(conn, nsub, responder_cnt, "pong-from-qore");

        # CLI sends request
        string output = backquote(natsCmd("request interop.cli-request 'ping' --raw --timeout=5s")
            + " 2>/dev/null");

        assertEq("pong-from-qore", trim(output));

        nsub.unsubscribe();
        responder_cnt.waitForZero(5s);
        conn.close();
    }

    private qoreResponder(NatsConnection conn, NatsSubscription nsub, Counter cnt, string reply_body) {
        on_exit cnt.dec();
        *hash<NatsMsgInfo> msg = nsub.nextMsg(10s);
        if (msg && msg.reply) {
            conn.publish(msg.reply, binary(reply_body));
            conn.flush();
        }
    }

    # ----------------------------------------------------------------
    # Core NATS: Qore sends request, nats CLI replies
    # ----------------------------------------------------------------
    qoreRequestCliReplyTest() {
%ifndef NoProcess
        # Start the CLI responder and wait until its subscription is active
        Process cli = startCli(("reply", "interop.qore-request", "pong-from-cli", "--count=1"));
        on_exit if (cli.running()) {
            cli.terminate();
            cli.wait();
        }
        server.waitForSubscription("interop.qore-request");

        # Qore sends request
        NatsConnection conn(url);
        hash<NatsMsgInfo> reply = conn.request("interop.qore-request", binary("ping"), 5s);
        assertEq("pong-from-cli", reply.data.toString());

        conn.close();
        waitCli(cli);
%endif
    }

    # ----------------------------------------------------------------
    # Headers: nats CLI publishes with headers, Qore reads them
    # ----------------------------------------------------------------
    cliHeadersQoreSubTest() {
        NatsConnection conn(url);
        NatsSubscription nsub = conn.subscribe("interop.cli-headers");
        conn.flush();

        # CLI publishes with headers
        system(natsCmd("pub interop.cli-headers 'header-payload'"
            + " -H 'X-Interop:from-cli' -H 'Content-Type:application/json'"));

        *hash<NatsMsgInfo> msg = nsub.nextMsg(5s);
        assertEq(True, exists msg);
        assertEq("header-payload", msg.data.toString());
        assertEq(True, exists msg.headers);
        assertEq("from-cli", msg.headers."X-Interop");
        assertEq("application/json", msg.headers."Content-Type");

        nsub.unsubscribe();
        conn.close();
    }

    # ----------------------------------------------------------------
    # Headers: Qore publishes with headers, nats CLI reads them
    # We verify the CLI receives the message (exit code 0) with the
    # expected body via --raw
    # ----------------------------------------------------------------
    qoreHeadersCliSubTest() {
%ifndef NoProcess
        # Start the CLI subscriber and wait until its subscription is active
        Process cli = startCli(("sub", "interop.qore-headers", "--count=1", "--raw", "--timeout=10s"));
        on_exit if (cli.running()) {
            cli.terminate();
            cli.wait();
        }
        server.waitForSubscription("interop.qore-headers");

        # Qore publishes with headers
        NatsConnection conn(url);
        conn.publishMsg("interop.qore-headers", binary("qore-header-msg"), {
            "X-Source": "qore-module",
            "Content-Type": "text/plain",
        });
        conn.flush();
        conn.close();

        # --raw gives just the body; headers are part of the NATS protocol but
        # not shown in raw mode, so we verify the body arrived intact
        assertEq("qore-header-msg", trim(waitCli(cli)));
%endif
    }

    # ----------------------------------------------------------------
    # JetStream: Qore publishes to stream, nats CLI reads
    # ----------------------------------------------------------------
    qoreJsPubCliConsumeTest() {
        NatsConnection conn(url);
        JetStreamContext js = conn.jetStream();

        string stream_name = uniqueName("INTJS");
        string subject = stream_name + ".data";

        js.addStream(<NatsStreamConfig>{
            "name": stream_name,
            "subjects": (stream_name + ".>",),
            "storage": NATS_STORAGE_MEMORY,
        });

        # Qore publishes via JetStream
        js.publish(subject, binary("js-from-qore"));

        # CLI reads via stream get (sequence 1)
        string output = backquote(natsCmd(sprintf("stream get %s 1", stream_name))
            + " 2>/dev/null");

        # Output contains the message body in the last line(s)
        assertTrue(output.find("js-from-qore") >= 0,
            "nats CLI should see the message published by Qore via JetStream");

        js.deleteStream(stream_name);
        conn.close();
    }

    # ----------------------------------------------------------------
    # JetStream: nats CLI publishes, Qore consumes via JetStream
    # ----------------------------------------------------------------
    cliPubQoreJsConsumeTest() {
        NatsConnection conn(url);
        JetStreamContext js = conn.jetStream();

        string stream_name = uniqueName("INTCL");
        string subject = stream_name + ".data";

        js.addStream(<NatsStreamConfig>{
            "name": stream_name,
            "subjects": (stream_name + ".>",),
            "storage": NATS_STORAGE_MEMORY,
        });

        # CLI publishes to the stream subject; with --jetstream it returns when the stream has stored the message
        assertEq(0, system(natsCmd(sprintf("pub %s 'js-from-cli' --jetstream", subject))));

        # Verify message count in stream
        hash<NatsStreamInfo> info = js.getStreamInfo(stream_name);
        assertEq(1, info.messages);

        # Qore consumes via pull subscriber
        string durable = "interop-consumer";
        NatsSubscription nsub = js.pullSubscribe(subject, durable);
        list<hash<NatsMsgInfo>> msgs = nsub.fetch(1, 5s);
        assertEq(1, msgs.size());
        assertEq("js-from-cli", msgs[0].data.toString());

        nsub.ack();
        nsub.unsubscribe();
        js.deleteStream(stream_name);
        conn.close();
    }

    # ----------------------------------------------------------------
    # KV: Qore puts, nats CLI gets
    # ----------------------------------------------------------------
    qoreKvPutCliGetTest() {
        NatsConnection conn(url);
        JetStreamContext js = conn.jetStream();

        string bucket = uniqueName("intkv");
        NatsKeyValueStore kv = js.createKeyValue(<NatsKVConfig>{
            "bucket": bucket,
            "storage": NATS_STORAGE_MEMORY,
        });

        # Qore puts a value
        kv.putString("interop-key", "value-from-qore");

        # CLI reads
        string output = backquote(natsCmd(sprintf("kv get %s interop-key --raw", bucket))
            + " 2>/dev/null");
        assertEq("value-from-qore", trim(output));

        js.deleteKeyValue(bucket);
        conn.close();
    }

    # ----------------------------------------------------------------
    # KV: nats CLI puts, Qore gets
    # ----------------------------------------------------------------
    cliKvPutQoreGetTest() {
        NatsConnection conn(url);
        JetStreamContext js = conn.jetStream();

        string bucket = uniqueName("intkvr");
        js.createKeyValue(<NatsKVConfig>{
            "bucket": bucket,
            "storage": NATS_STORAGE_MEMORY,
        });

        # CLI puts a value
        system(natsCmd(sprintf("kv put %s cli-key 'value-from-cli'", bucket)));

        # Qore reads
        NatsKeyValueStore kv = js.keyValue(bucket);
        *hash<NatsKVEntry> entry = kv.get("cli-key");
        assertEq(True, exists entry);
        assertEq("cli-key", entry.key);
        assertEq("value-from-cli", entry.value.toString());
        assertEq(NATS_KV_OP_PUT, entry.operation);

        js.deleteKeyValue(bucket);
        conn.close();
    }
}
